{
  "name": "@gd/ui",
  "type": "module",
  "module": "./dist/ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/ui.es.js"
    },
    "./style.css": "./src/style.css"
  },
  "scripts": {
    "build": "vite build --",
    "dev": "vite build --watch",
    "showcase:dev": "vite --config showcase/vite.config.mjs",
    "showcase:build": "vite build --config showcase/vite.config.mjs",
    "showcase:preview": "vite preview --config showcase/vite.config.mjs",
    "lint": "tsc && pnpm --dir ../.. exec eslint packages/ui --quiet && pnpm --dir ../.. exec prettier --check packages/ui",
    "lint-fix": "tsc && pnpm --dir ../.. exec eslint packages/ui --quiet --fix && pnpm --dir ../.. exec prettier --write packages/ui",
    "test:unit": "vitest run"
  },
  "pnpm": {
    "overrides": {
      "@tanstack/react-router": "npm:@tanstack/solid-router"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@floating-ui/dom": "^1.7.6",
    "@gd/config": "workspace:*",
    "@kobalte/core": "^0.13.11",
    "@tanstack/router-vite-plugin": "^1.166.2",
    "@tanstack/solid-router": "^1.166.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^25.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "jsdom": "^28.1.0",
    "solid-floating-ui": "^0.3.1",
    "solid-js": "^1.9.11",
    "solid-testing-library": "^0.5.0",
    "somoto": "^0.0.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "unocss": "^66.6.5",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.0.18"
  }
}
