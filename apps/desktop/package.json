{
  "name": "@gd/desktop",
  "productName": "GDLauncher",
  "private": true,
  "description": "GDLauncher Carbon.",
  "author": "GorillaDevs Inc.",
  "email": "support@gdlauncher.com",
  "homepage": "https://gdlauncher.com",
  "license": "ARR",
  "type": "module",
  "_comment": "DO NOT MANUALLY EDIT THE VERSION",
  "version": "2.0.28",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/watch.mjs",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "build-vite": "node scripts/build.mjs",
    "patch-version": "node scripts/monkeypatchVersion.mjs",
    "build-electron": "cross-env-shell DEBUG=electron-builder ow-electron-builder --config .electron-builder.config.cjs",
    "build": "pnpm patch-version && pnpm build-vite && pnpm build-electron",
    "clean": "node scripts/cleanReleaseFolder.mjs",
    "lint": "tsc && pnpm --dir ../.. exec eslint apps/desktop --quiet && pnpm --dir ../.. exec prettier --check apps/desktop",
    "lint-fix": "tsc && pnpm --dir ../.. exec eslint apps/desktop --quiet --fix && pnpm --dir ../.. exec prettier --write apps/desktop",
    "release": "node scripts/releaseDraft.mjs",
    "translations:validate-english-keys": "node scripts/validateEnglishKeys.mjs",
    "translations:gen-types": "node scripts/generateTranslationTypes.mjs",
    "translations:validate-sync": "node scripts/validateTranslationSync.mjs",
    "translations:sync": "node scripts/syncTranslations.mjs"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron-builder-squirrel-windows": "26.8.1",
    "@gd/config": "workspace:*",
    "@gd/core_module": "workspace:*",
    "@gd/i18n": "workspace:*",
    "@gd/ui": "workspace:*",
    "@overwolf/ow-electron": "39.6.0",
    "@overwolf/ow-electron-builder": "^26.0.12",
    "@playwright/test": "^1.58.2",
    "@rive-app/canvas": "^2.35.0",
    "@sentry/electron": "^7.9.0",
    "@sentry/vite-plugin": "^5.1.1",
    "@solid-primitives/deep": "^0.3.5",
    "@solid-primitives/keyboard": "^1.3.5",
    "@solid-primitives/map": "^0.7.3",
    "@solidjs/router": "^0.15.3",
    "@tanstack/solid-query": "^5.90.23",
    "@tanstack/solid-table": "^8.21.3",
    "@tanstack/solid-virtual": "3.13.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/lodash": "^4.17.24",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.0",
    "@unocss/reset": "^66.6.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "electron": "39.6.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "html-parse-string": "^0.0.9",
    "jsdom": "^28.1.0",
    "lodash": "^4.17.21",
    "marked": "^17.0.4",
    "playwright": "^1.58.2",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.1",
    "solid-js": "^1.9.11",
    "virtua": "0.48.6",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.0.18"
  },
  "env": {
    "//": "Used in build scripts",
    "PORT": 3344
  }
}
