---
import HeaderLink from "./HeaderLink.astro";
import { Image } from "astro:assets";
import Logo from "../assets/logo.svg";
import DownloadButton from "./DownloadButton.astro";
import LocaleSwitcher from "./LocaleSwitcher.astro";
import { APP_URLS } from "../consts";
import DocsSideNav from "./DocsSideNav.astro";
import {
  getLocaleFromUrl,
  pathWithoutLocale,
  localizedPath,
  useTranslations,
} from "../lib/i18n";

const { pathname } = Astro.url;
const locale = getLocaleFromUrl(pathname);
const t = useTranslations(locale);
// Active-state checks compare against the locale-stripped path so the
// nav highlights correctly on /ja/blog, /es/guides, etc.
const basePath = pathWithoutLocale(pathname);
---

<header class="sticky top-0 z-50 bg-darkSlate-800/80 backdrop-blur-lg border-b border-darkSlate-700/50">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href={localizedPath("/", locale)} class="group relative flex items-center px-3 py-2 transition-transform duration-100 ease-spring active:scale-95">
      <div class="absolute inset-0 bg-darkSlate-700 rounded-lg scale-75 opacity-0 transition-all duration-150 ease-out group-hover:scale-100 group-hover:opacity-100"></div>
      <Image src={Logo} alt="GDLauncher logo" width="150" height="35" class="relative z-10" loading="eager" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center bg-darkSlate-700 rounded-lg p-1 gap-1">
      <HeaderLink
        class="nav-tab"
        href={localizedPath("/", locale)}
        data-active={basePath === "/" ? "true" : "false"}
      >
        <div class="i-hugeicons:home-01 w-5 h-5"></div>
        <span>{t("nav.home")}</span>
      </HeaderLink>

      <HeaderLink
        class="nav-tab"
        href={localizedPath("/blog", locale)}
        data-active={basePath.startsWith("/blog") ? "true" : "false"}
      >
        <div class="i-hugeicons:news w-5 h-5"></div>
        <span>{t("nav.blog")}</span>
      </HeaderLink>

      <HeaderLink
        class="nav-tab"
        href={localizedPath("/guides", locale)}
        data-active={basePath.startsWith("/guides") ? "true" : "false"}
      >
        <div class="i-hugeicons:book-open-01 w-5 h-5"></div>
        <span>{t("nav.guides")}</span>
      </HeaderLink>

      <HeaderLink
        class="nav-tab"
        href={localizedPath("/docs", locale)}
        data-active={basePath.startsWith("/docs") ? "true" : "false"}
      >
        <div class="i-hugeicons:book-02 w-5 h-5"></div>
        <span>{t("nav.docs")}</span>
      </HeaderLink>

      <a
        class="nav-tab"
        href={APP_URLS.socials.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="i-hugeicons:github w-5 h-5"></div>
        <span>{t("nav.github")}</span>
      </a>
    </nav>

    <!-- Download Button + Locale Switcher (Desktop) -->
    <div class="hidden md:flex items-center gap-2">
      <LocaleSwitcher />
      <DownloadButton />
    </div>

    <!-- Mobile Menu Button -->
    <button
      class="md:hidden p-2 rounded-lg hover:bg-darkSlate-700 transition-colors transition-transform duration-100 ease-spring active:scale-95"
      data-open-nav
      aria-controls="sidebar"
      aria-expanded="false"
      aria-label={t("nav.openMenu")}
    >
      <div class="i-hugeicons:menu-02 w-6 h-6 text-lightSlate-100"></div>
    </button>
  </div>
</header>

<!-- Mobile Navigation Overlay (outside header to avoid backdrop-blur stacking context) -->
<nav id="sidebar" class="mobile-nav">
  <div class="flex items-center justify-between px-4 h-16 border-b border-darkSlate-700">
    <a href={localizedPath("/", locale)} class="px-3 py-2">
      <Image src={Logo} alt="GDLauncher logo" width="150" height="35" loading="eager" />
    </a>
    <button class="p-2 rounded-lg hover:bg-darkSlate-700 transition-colors" data-close-nav aria-label={t("nav.closeMenu")}>
      <div class="i-hugeicons:cancel-01 w-6 h-6 text-lightSlate-100"></div>
    </button>
  </div>

  <div class="flex flex-col p-4 gap-2">
    <HeaderLink class="mobile-nav-link" href={localizedPath("/", locale)}>
      <div class="i-hugeicons:home-01 w-5 h-5"></div>
      <span>{t("nav.home")}</span>
    </HeaderLink>

    <HeaderLink class="mobile-nav-link" href={localizedPath("/blog", locale)}>
      <div class="i-hugeicons:news w-5 h-5"></div>
      <span>{t("nav.blog")}</span>
    </HeaderLink>

    <HeaderLink class="mobile-nav-link" href={localizedPath("/guides", locale)}>
      <div class="i-hugeicons:book-open-01 w-5 h-5"></div>
      <span>{t("nav.guides")}</span>
    </HeaderLink>

    <HeaderLink class="mobile-nav-link" href={localizedPath("/docs", locale)}>
      <div class="i-hugeicons:book-02 w-5 h-5"></div>
      <span>{t("nav.docs")}</span>
    </HeaderLink>

    <a class="mobile-nav-link" href={APP_URLS.socials.github} target="_blank" rel="noopener noreferrer">
      <div class="i-hugeicons:github w-5 h-5"></div>
      <span>{t("nav.github")}</span>
    </a>

    <div class="mt-4 pt-4 border-t border-darkSlate-700">
      <p class="px-4 mb-2 text-xs uppercase tracking-wider text-darkSlate-200">{t("nav.language")}</p>
      <LocaleSwitcher />
    </div>
  </div>

  {pathname.includes("docs") && (
    <div class="p-4 border-t border-darkSlate-700">
      <DocsSideNav />
    </div>
  )}

</nav>


<style is:global>
  .nav-tab {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgb(var(--lightSlate-600));
    transition: color 0.15s ease, transform 0.1s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .nav-tab:active {
    transform: scale(0.95);
  }

  .nav-tab::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: rgb(var(--darkSlate-600));
    border-radius: 0.375rem;
    transform: scale(0.75);
    opacity: 0;
    transition: transform 0.15s ease-out, opacity 0.15s ease-out;
    z-index: -1;
  }

  .nav-tab:hover {
    color: rgb(var(--lightSlate-400));
  }

  .nav-tab:hover::before {
    transform: scale(1);
    opacity: 1;
  }

  .nav-tab[data-active="true"] {
    background-color: rgb(var(--primary-500));
    color: rgb(var(--lightSlate-50));
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.2);
  }

  .nav-tab[data-active="true"]::before {
    display: none;
  }

  .nav-tab[data-active="true"]:hover {
    background-color: rgb(var(--primary-400));
    color: rgb(var(--lightSlate-50));
  }

  .mobile-nav {
    display: none;
    position: fixed;
    inset: 0;
    background-color: rgb(var(--darkSlate-800));
    z-index: 100;
    flex-direction: column;
    overflow-y: auto;
  }

  .mobile-nav.visible {
    display: flex;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-radius: 0.5rem;
    font-size: 1rem;
    color: rgb(var(--lightSlate-100));
    transition: all 0.15s ease, transform 0.1s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .mobile-nav-link:active {
    transform: scale(0.98);
  }

  .mobile-nav-link:hover {
    background-color: rgb(var(--darkSlate-700));
    color: rgb(var(--lightSlate-50));
  }
</style>

<script>
  // Mobile-nav controller. Bound via data-attributes (not inline onclick) so
  // Astro's default module-scoped script processing doesn't break it.
  // Setup runs on initial load and on every view-transition swap; handlers
  // are tagged idempotently so re-running on the same node is safe.

  function setOpen(open: boolean) {
    const sidebar = document.getElementById("sidebar");
    const triggers = document.querySelectorAll<HTMLButtonElement>("[data-open-nav]");
    sidebar?.classList.toggle("visible", open);
    document.body.classList.toggle("no-scroll", open);
    triggers.forEach((t) => t.setAttribute("aria-expanded", String(open)));
    if (open) {
      // Move focus into the menu so keyboard users can navigate it; the
      // close button is the natural first stop.
      const closeBtn = document.querySelector<HTMLButtonElement>("[data-close-nav]");
      closeBtn?.focus();
    } else {
      // Return focus to whichever open trigger was last visible.
      const trigger = document.querySelector<HTMLButtonElement>("[data-open-nav]");
      trigger?.focus();
    }
  }

  function setup() {
    document.querySelectorAll<HTMLButtonElement>("[data-open-nav]").forEach((btn) => {
      if (btn.dataset.navInit === "1") return;
      btn.dataset.navInit = "1";
      btn.addEventListener("click", () => setOpen(true));
    });
    document.querySelectorAll<HTMLButtonElement>("[data-close-nav]").forEach((btn) => {
      if (btn.dataset.navInit === "1") return;
      btn.dataset.navInit = "1";
      btn.addEventListener("click", () => setOpen(false));
    });
  }

  // Document-level handlers attach exactly once. They keep working across
  // view transitions because the listener stays bound to `document`, which
  // persists, while the menu DOM nodes get re-resolved each fire.
  if (!(window as unknown as { __navDocBound?: boolean }).__navDocBound) {
    (window as unknown as { __navDocBound?: boolean }).__navDocBound = true;
    window.addEventListener("resize", () => {
      if (window.innerWidth > 768) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && document.getElementById("sidebar")?.classList.contains("visible")) {
        setOpen(false);
      }
    });
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>
