---
import HeaderLink from "./HeaderLink.astro";
import { Image } from "astro:assets";
import Logo from "../assets/logo.svg";
import DownloadButton from "./DownloadButton.astro";
import { APP_URLS } from "../consts";
import DocsSideNav from "./DocsSideNav.astro";

const { pathname } = Astro.url;
---

<header class="sticky top-0 z-50 bg-darkSlate-800/80 backdrop-blur-lg border-b border-darkSlate-700/50" data-scroll="fade">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="group relative flex items-center px-3 py-2 transition-transform duration-100 ease-spring active:scale-95">
      <div class="absolute inset-0 bg-darkSlate-700 rounded-lg scale-75 opacity-0 transition-all duration-150 ease-out group-hover:scale-100 group-hover:opacity-100"></div>
      <Image src={Logo} alt="gdlauncher logo" width="150" height="35" class="relative z-10" loading="eager" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center bg-darkSlate-700 rounded-lg p-1 gap-1">
      <HeaderLink
        class="nav-tab"
        href="/"
        data-active={pathname === "/" ? "true" : "false"}
      >
        <div class="i-hugeicons:home-01 w-5 h-5"></div>
        <span>Home</span>
      </HeaderLink>

      <HeaderLink
        class="nav-tab"
        href="/blog"
        data-active={pathname.startsWith("/blog") ? "true" : "false"}
      >
        <div class="i-hugeicons:news w-5 h-5"></div>
        <span>Blog</span>
      </HeaderLink>

      <HeaderLink
        class="nav-tab"
        href="/guides"
        data-active={pathname.startsWith("/guides") ? "true" : "false"}
      >
        <div class="i-hugeicons:book-open-01 w-5 h-5"></div>
        <span>Guides</span>
      </HeaderLink>

      <HeaderLink
        class="nav-tab"
        href="/docs"
        data-active={pathname.startsWith("/docs") ? "true" : "false"}
      >
        <div class="i-hugeicons:book-02 w-5 h-5"></div>
        <span>Docs</span>
      </HeaderLink>

      <a
        class="nav-tab"
        href={APP_URLS.socials.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="i-hugeicons:github w-5 h-5"></div>
        <span>GitHub</span>
      </a>
    </nav>

    <!-- Download Button (Desktop) -->
    <div class="hidden md:block">
      <DownloadButton />
    </div>

    <!-- Mobile Menu Button -->
    <button class="md:hidden p-2 rounded-lg hover:bg-darkSlate-700 transition-colors transition-transform duration-100 ease-spring active:scale-95" onclick="openNav()">
      <div class="i-hugeicons:menu-02 w-6 h-6 text-lightSlate-100"></div>
    </button>
  </div>

  <!-- Mobile Navigation Overlay -->
  <nav id="sidebar" class="mobile-nav">
    <div class="flex items-center justify-between p-4 border-b border-darkSlate-700">
      <a href="/">
        <Image src={Logo} alt="gdlauncher logo" width="140" height="32" loading="eager" />
      </a>
      <button class="p-2 rounded-lg hover:bg-darkSlate-700 transition-colors" onclick="closeNav()">
        <div class="i-hugeicons:cancel-01 w-6 h-6 text-lightSlate-100"></div>
      </button>
    </div>

    <div class="flex flex-col p-4 gap-2">
      <HeaderLink class="mobile-nav-link" href="/">
        <div class="i-hugeicons:home-01 w-5 h-5"></div>
        <span>Home</span>
      </HeaderLink>

      <HeaderLink class="mobile-nav-link" href="/blog">
        <div class="i-hugeicons:news w-5 h-5"></div>
        <span>Blog</span>
      </HeaderLink>

      <HeaderLink class="mobile-nav-link" href="/guides">
        <div class="i-hugeicons:book-open-01 w-5 h-5"></div>
        <span>Guides</span>
      </HeaderLink>

      <HeaderLink class="mobile-nav-link" href="/docs">
        <div class="i-hugeicons:book-02 w-5 h-5"></div>
        <span>Docs</span>
      </HeaderLink>

      <a class="mobile-nav-link" href={APP_URLS.socials.github} target="_blank" rel="noopener noreferrer">
        <div class="i-hugeicons:github w-5 h-5"></div>
        <span>GitHub</span>
      </a>
    </div>

    {pathname.includes("docs") && (
      <div class="p-4 border-t border-darkSlate-700">
        <DocsSideNav />
      </div>
    )}

    <div class="p-4 mt-auto">
      <DownloadButton />
    </div>
  </nav>
</header>

<style is:global>
  .nav-tab {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgb(var(--lightSlate-600));
    transition: color 0.15s ease, transform 0.1s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .nav-tab:active {
    transform: scale(0.95);
  }

  .nav-tab::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: rgb(var(--darkSlate-600));
    border-radius: 0.375rem;
    transform: scale(0.75);
    opacity: 0;
    transition: transform 0.15s ease-out, opacity 0.15s ease-out;
    z-index: -1;
  }

  .nav-tab:hover {
    color: rgb(var(--lightSlate-400));
  }

  .nav-tab:hover::before {
    transform: scale(1);
    opacity: 1;
  }

  .nav-tab[data-active="true"] {
    background-color: rgb(var(--primary-500));
    color: rgb(var(--lightSlate-50));
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.2);
  }

  .nav-tab[data-active="true"]::before {
    display: none;
  }

  .nav-tab[data-active="true"]:hover {
    background-color: rgb(var(--primary-400));
    color: rgb(var(--lightSlate-50));
  }

  .mobile-nav {
    display: none;
    position: fixed;
    inset: 0;
    background-color: rgb(var(--darkSlate-800));
    z-index: 100;
    flex-direction: column;
    overflow-y: auto;
  }

  .mobile-nav.visible {
    display: flex;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-radius: 0.5rem;
    font-size: 1rem;
    color: rgb(var(--lightSlate-100));
    transition: all 0.15s ease, transform 0.1s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .mobile-nav-link:active {
    transform: scale(0.98);
  }

  .mobile-nav-link:hover {
    background-color: rgb(var(--darkSlate-700));
    color: rgb(var(--lightSlate-50));
  }
</style>

<script defer>
  window.addEventListener("resize", () => {
    if (window.innerWidth > 768) {
      document.getElementById("sidebar")?.classList.remove("visible");
      document.body.classList.remove("no-scroll");
    }
  });

  function openNav() {
    document.getElementById("sidebar")?.classList.add("visible");
    document.body.classList.add("no-scroll");
  }

  function closeNav() {
    document.getElementById("sidebar")?.classList.remove("visible");
    document.body.classList.remove("no-scroll");
  }
</script>
