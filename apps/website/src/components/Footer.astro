---
import Logo from "../assets/logo.svg";
import { Image } from "astro:assets";
import HeaderLink from "./HeaderLink.astro";
import Twitter from "../assets/twitter.svg";
import Discord from "../assets/discord.svg";
import NewsLetter from "./Newsletter";
import { APP_URLS } from "../consts";
import { getLocaleFromUrl, localizedPath, useTranslations } from "../lib/i18n";

const locale = getLocaleFromUrl(Astro.url.pathname);
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="flex flex-col">
  <div class="flex flex-col lg:flex-row justify-between p-16 space-x-0.5">
    <div class="flex flex-col items-start flex-1">
      <Image src={Logo} alt="GDLauncher logo" class="pb-4" />
      <p class="text-graygd w-1/2">{t("footer.tagline")}</p>
    </div>

    <div class="flex-[0.5]">
      <span class="text-white font-medium">{t("footer.section.download")}</span>
      <ul class="flex lg:flex-col gap-2 lg:gap-0 pt-4">
        <li>
          <HeaderLink href="/download/windows">{t("footer.os.windows")}</HeaderLink>
        </li>
        <li>
          <HeaderLink href="/download/mac">{t("footer.os.macos")}</HeaderLink>
        </li>
        <li>
          <HeaderLink href="/download/linux">{t("footer.os.linux")}</HeaderLink>
        </li>
      </ul>
    </div>

    <NewsLetter
      client:idle
      labels={{
        heading: t("newsletter.heading"),
        emailPlaceholder: t("newsletter.emailPlaceholder"),
        subscribe: t("newsletter.subscribe"),
        errorAlreadySubscribed: t("newsletter.error.alreadySubscribed"),
        errorMissingInfo: t("newsletter.error.missingInfo"),
        errorInvalidEmail: t("newsletter.error.invalidEmail"),
        success: t("newsletter.success"),
      }}
    />
    <div class="flex-[0.5]">
      <span class="text-white font-medium">{t("footer.section.oldDownload")}</span>
      <ul class="flex lg:flex-col gap-2 lg:gap-0 pt-4">
        <li>
          <HeaderLink href={APP_URLS.olddownload.win}>{t("footer.os.windows")}</HeaderLink>
        </li>
        <li>
          <HeaderLink href={APP_URLS.olddownload.macOs}>{t("footer.os.macos")}</HeaderLink>
        </li>
        <li>
          <HeaderLink href={APP_URLS.olddownload.linux}>{t("footer.os.linux")}</HeaderLink>
        </li>
      </ul>
    </div>
    <div class="flex-[0.5]">
      <span class="text-white font-medium">{t("footer.section.legal")}</span>
      <ul class="flex lg:flex-col gap-2 lg:gap-0 pt-4">
        <li>
          <HeaderLink href={localizedPath("/terms-of-service", locale)} class="pt-4">
            {t("footer.legal.tos")}
          </HeaderLink>
        </li>
        <li>
          <HeaderLink href={localizedPath("/privacy-statement", locale)}>{t("footer.legal.privacy")}</HeaderLink>
        </li>
      </ul>
    </div>
    <div class="flex-1">
      <span class="text-white font-medium">{t("footer.section.contact")}</span>
      <ul class="flex gap-2 pt-4">
        <li>
          <HeaderLink href={APP_URLS.socials.discord}>
            <Image src={Discord} alt="GDLauncher on Discord" />
          </HeaderLink>
        </li>
        <li>
          <HeaderLink href={APP_URLS.socials.twitter}>
            <Image src={Twitter} alt="GDLauncher on Twitter" />
          </HeaderLink>
        </li>
      </ul>
      <div class="flex flex-col">
        <span class="text-graygd">
          {t("footer.copyrightLine").replace("{year}", String(year))}
        </span>
      </div>
    </div>
  </div>
  <span class="text-graygd text-center pb-2 text-sm">
    {t("footer.disclaimer")}
  </span>
</footer>
<style>
  a {
    cursor: pointer;
    color: rgb(var(--darkSlate-50));
  }
  ul {
    list-style: none;
  }
  footer {
    background-color: rgb(var(--darkSlate-800));
  }
  @media screen and (max-width: 768px) {
    footer > div {
      gap: 1rem;
    }
  }

  li a {
    position: relative;
    display: inline-block;
    padding: 0.25rem 0.5rem;
    margin: -0.25rem -0.5rem;
    border-radius: 0.375rem;
    transition: color 0.15s ease, transform 0.1s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  li a:active {
    transform: scale(0.98);
  }

  li a::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: rgb(var(--darkSlate-700));
    border-radius: 0.375rem;
    transform: scale(0.75);
    opacity: 0;
    transition: transform 0.15s ease-out, opacity 0.15s ease-out;
    z-index: -1;
  }

  li a:hover {
    color: rgb(var(--lightSlate-50));
  }

  li a:hover::before {
    transform: scale(1);
    opacity: 1;
  }
</style>
