---
import {
  getLocaleFromUrl,
  localizedPath,
  getHtmlLang,
} from "../lib/i18n";

const { post } = Astro.props;
const locale = getLocaleFromUrl(Astro.url.pathname);

// Match the Intl date formatting to the active locale so /es/blog shows
// dates in Spanish, /ja/blog in Japanese, etc.
const formatDate = (date: Date) => {
  const options: Intl.DateTimeFormatOptions = {
    day: "2-digit",
    month: "long",
    year: "numeric",
  };
  return new Intl.DateTimeFormat(getHtmlLang(locale), options).format(
    new Date(date),
  );
};

const href = localizedPath(`/blog/${post.slug}`, locale);
---

<a
  href={href}
  aria-label={post.data.title}
  class="block transition-transform duration-100 ease-spring active:scale-98"
>
  <article
    class="max-w-lg rounded-xl bg-slate-900 hover:-translate-y-4 ease-in-out duration-200 overflow-hidden"
  >
    {/* Real <img> instead of CSS background so the browser can lazy-load
        below-the-fold cards and the card image counts toward LCP / SEO. */}
    <img
      src={post.data.heroImage}
      alt=""
      width="800"
      height="420"
      loading="lazy"
      decoding="async"
      class="w-full h-[18rem] object-cover bg-primary-500/30"
    />
    <div class="flex flex-col justify-between py-10 px-14 min-h-72">
      <div>
        <h2 class="text-2xl font-bold mb-4">{post.data.title}</h2>
        <p class="text-slate-400">{post.data.description}</p>
      </div>
      <p class="text-sm pt-3 text-slate-500">
        {post.data.author} - {formatDate(post.data.pubDate)}
      </p>
    </div>
  </article>
</a>
