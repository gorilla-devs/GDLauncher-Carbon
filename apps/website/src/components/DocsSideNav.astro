---
import {
  getLocaleFromUrl,
  pathWithoutLocale,
  localizedPath,
  type Locale,
} from "../lib/i18n";

// Locale-aware active-state: compare the current path with its locale prefix
// stripped against the canonical page slug. Hrefs are built with
// localizedPath() so clicking inside /ja/docs stays in /ja/docs.
const rawPathname = Astro.url.pathname;
const trimmed = rawPathname.endsWith("/") && rawPathname !== "/"
  ? rawPathname.slice(0, -1)
  : rawPathname;
const locale = getLocaleFromUrl(trimmed);
const basePath = pathWithoutLocale(trimmed);

