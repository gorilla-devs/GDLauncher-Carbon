---
// Normalize pathname by removing trailing slash
const rawPathname = Astro.url.pathname;
const pathname = rawPathname.endsWith('/') && rawPathname !== '/'
  ? rawPathname.slice(0, -1)
  : rawPathname;

const sidebar = [
  {
    category: "Introduction",
    pages: [
      {
        title: "Welcome to GDLauncher",
        slug: "",
      },
    ],
  },
  {
    category: "Installation",
    pages: [
      {
        title: "Migration from Legacy GDLauncher",
        slug: "migration-from-legacy-gdlauncher",
      },
      {
        title: "Installation",
        slug: "installation",
      },
    ],
  },
  {
    category: "Troubleshooting",
    pages: [
      {
        title: "Troubleshooting",
        slug: "troubleshooting",
      },
    ],
  },
  {
    category: "FAQ",
    pages: [
      {
        title: "GDLauncher vs GDLauncher Carbon",
        slug: "gdlauncher-vs-gdlauncher-carbon",
      },
    ],
  },
];
---

<nav class="docs-nav py-6">
  {
    sidebar.map(({ category, pages }) => {
      const hasActivePage = pages.some(({ slug }) => {
        const pageUrl = slug ? `/docs/${slug}` : '/docs';
        return pathname === pageUrl;
      });

      return (
        <div class="category mb-6" data-expanded={hasActivePage ? "true" : "true"}>
          <button
            type="button"
            class="category-header w-full flex items-center justify-between px-3 py-2 text-sm font-semibold uppercase tracking-wider text-darkSlate-100 hover:text-lightSlate-50 transition-colors rounded-lg hover:bg-darkSlate-700/50"
          >
            <span>{category}</span>
            <div class="i-hugeicons:arrow-down-01 w-4 h-4 chevron-icon transition-transform duration-200"></div>
          </button>
          <ul class="category-items mt-1 ml-1 space-y-1 overflow-hidden">
            {pages.map(({ title, slug }) => {
              const pageUrl = slug ? `/docs/${slug}` : '/docs';
              const isActive = pathname === pageUrl;

              return (
                <li>
                  <a
                    href={pageUrl}
                    class:list={[
                      "nav-link block py-1.5 px-3 text-sm transition-colors duration-150",
                      {
                        "text-primary-400 font-medium": isActive,
                        "text-darkSlate-100 hover:text-lightSlate-50": !isActive,
                      },
                    ]}
                  >
                    {title}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      );
    })
  }
</nav>

<style is:global>
  .category-items li {
    margin-bottom: 0;
  }

  .category[data-expanded="false"] .category-items {
    max-height: 0;
    opacity: 0;
  }

  .category[data-expanded="true"] .category-items {
    max-height: 500px;
    opacity: 1;
  }

  .category[data-expanded="false"] .chevron-icon {
    transform: rotate(-90deg);
  }

  .category-items {
    transition: max-height 0.3s ease, opacity 0.2s ease;
  }
</style>

<script>
  function initDocsSideNav() {
    document.querySelectorAll('.category-header').forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.closest('.category');
        if (category) {
          const isExpanded = category.getAttribute('data-expanded') === 'true';
          category.setAttribute('data-expanded', isExpanded ? 'false' : 'true');
        }
      });
    });
  }

  // Run on initial load
  initDocsSideNav();

  // Re-run on Astro page transitions
  document.addEventListener('astro:page-load', initDocsSideNav);
</script>
