---
/**
 * GuideLayout - Layout for guide/tutorial pages
 */
import PageShell from "./PageShell.astro"
import Breadcrumb from "./Breadcrumb.astro"

interface Props {
  title: string
  description: string
  keywords?: string
  lastUpdated?: string
}

const { title, description, keywords, lastUpdated } = Astro.props

const seoTitle = `${title} | GDLauncher Guides`
---

<PageShell
  title={seoTitle}
  description={description}
  keywords={keywords}
>
    <main class="py-8">
      <Breadcrumb items={[
        { label: "Guides", href: "/guides" },
        { label: title }
      ]} />

      <div class="max-w-4xl mx-auto px-4">
        <div class="bg-darkSlate-800 rounded-xl p-8 md:p-12">
        <!-- Article header -->
        <header class="mb-10">
          <h1 class="text-3xl md:text-4xl font-bold text-lightSlate-50 mb-4">
            {title}
          </h1>
          <p class="text-lg text-darkSlate-100 mb-4">
            {description}
          </p>
          {lastUpdated && (
            <p class="text-sm text-darkSlate-200">
              Last updated: {lastUpdated}
            </p>
          )}
        </header>

        <!-- Article content -->
        <article class="prose prose-invert prose-lg max-w-none">
          <slot />
        </article>
        </div>

        <!-- Download CTA -->
        <div class="mt-8 bg-gradient-to-r from-primary-600/20 to-primary-800/20 border border-primary-500/30 rounded-xl p-8 text-center">
        <h2 class="text-2xl font-bold text-lightSlate-50 mb-3">
          Ready to Get Started?
        </h2>
        <p class="text-darkSlate-100 mb-6 max-w-xl mx-auto">
          Download GDLauncher and start playing modded Minecraft in minutes. One-click install for modpacks, mods, and more.
        </p>
        <a
          href="/download/windows"
          data-astro-prefetch="false"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-primary-500 hover:bg-primary-600 text-lightSlate-50 font-semibold transition-colors"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 12V6.75l6-1.32v6.48L3 12zm17-9v8.75l-10 .15V5.21L20 3zM3 13l6 .09v6.81l-6-1.15V13zm17 .25V22l-10-1.91V13.1l10 .15z"/>
          </svg>
          Download GDLauncher
        </a>
        </div>
      </div>
    </main>
</PageShell>

<style is:global>
  .prose {
    color: rgb(var(--lightSlate-100));
  }

  .prose h2 {
    color: rgb(var(--lightSlate-50));
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    color: rgb(var(--lightSlate-50));
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .prose p {
    margin-bottom: 1rem;
    line-height: 1.75;
  }

  .prose ul, .prose ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose code {
    background-color: rgb(var(--darkSlate-600));
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }

  .prose pre {
    background-color: rgb(var(--darkSlate-700));
    border: 1px solid rgb(var(--darkSlate-600));
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }

  .prose pre code {
    background: none;
    padding: 0;
    border-radius: 0;
  }

  .prose a {
    color: rgb(var(--primary-400));
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .prose a:hover {
    color: rgb(var(--primary-300));
  }

  .prose strong {
    color: rgb(var(--lightSlate-50));
    font-weight: 600;
  }

  .prose blockquote {
    border-left: 4px solid rgb(var(--primary-500));
    padding-left: 1rem;
    margin-left: 0;
    color: rgb(var(--darkSlate-100));
    font-style: italic;
  }

  .prose img {
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }
</style>
