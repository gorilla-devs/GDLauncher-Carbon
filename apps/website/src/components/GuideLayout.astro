---
/**
 * GuideLayout - Layout for guide/tutorial pages.
 *
 * Pages can opt into HowTo structured data by passing `howTo`, an ordered
 * list of steps. We emit it as JSON-LD so eligible guides can earn Google's
 * "How-to" rich result, which both takes more SERP real estate and lifts
 * CTR substantially.
 */
import PageShell from "./PageShell.astro"
import Breadcrumb from "./Breadcrumb.astro"
import { DownloadLink } from "./DownloadLink"
import { howToJsonLd, breadcrumbsJsonLd } from "../lib/jsonld"
import { getLocaleFromUrl, localizedPath, useTranslations } from "../lib/i18n"

interface Props {
  title: string
  description: string
  keywords?: string
  lastUpdated?: string
  /** Optional HowTo schema. Pass an array of steps to emit it. */
  howTo?: {
    steps: Array<{ name: string; text: string }>
    totalTimeIso?: string
    image?: string
  }
}

const { title, description, keywords, lastUpdated, howTo } = Astro.props

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = useTranslations(locale)

const seoTitle = `${title} | GDLauncher`
const canonicalUrl = new URL(Astro.url.pathname, "https://gdlauncher.com").toString()
const guidesUrl = new URL(localizedPath("/guides", locale), "https://gdlauncher.com").toString()

const jsonLd: Record<string, unknown>[] = [
  breadcrumbsJsonLd([
    { name: t("breadcrumb.home"), url: "https://gdlauncher.com/" },
    { name: t("nav.guides"), url: guidesUrl },
    { name: title, url: canonicalUrl },
  ]),
]
if (howTo) {
  jsonLd.push(
    howToJsonLd({
      name: title,
      description,
      url: canonicalUrl,
      steps: howTo.steps,
      totalTimeIso: howTo.totalTimeIso,
      image: howTo.image,
    })
  )
}
---

<PageShell
  title={seoTitle}
  description={description}
  keywords={keywords}
  jsonLd={jsonLd}
>
    <main class="py-8">
      <Breadcrumb items={[
        { label: t("nav.guides"), href: localizedPath("/guides", locale) },
        { label: title }
      ]} />

      <div class="max-w-4xl mx-auto px-4">
        <div class="bg-darkSlate-800 rounded-xl p-8 md:p-12">
        <!-- Article header -->
        <header class="mb-10">
          <h1 class="text-3xl md:text-4xl font-bold text-lightSlate-50 mb-4">
            {title}
          </h1>
          <p class="text-lg text-darkSlate-100 mb-4">
            {description}
          </p>
          {lastUpdated && (
            <p class="text-sm text-darkSlate-200">
              {t("blog.updated")}: {lastUpdated}
            </p>
          )}
        </header>

        <!-- Article content -->
        <article class="prose prose-invert prose-lg max-w-none">
          <slot />
        </article>
        </div>

        <!-- Download CTA -->
        <div class="mt-8 bg-gradient-to-r from-primary-600/20 to-primary-800/20 border border-primary-500/30 rounded-xl p-8 text-center">
        <h2 class="text-2xl font-bold text-lightSlate-50 mb-3">
          {t("blog.cta.heading")}
        </h2>
        <p class="text-darkSlate-100 mb-6 max-w-xl mx-auto">
          {t("blog.cta.body")}
        </p>
        <DownloadLink
          client:idle
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-primary-500 hover:bg-primary-600 text-lightSlate-50 font-semibold transition-colors"
          iconClass="w-5 h-5"
          label={t("blog.cta.button")}
          iconLeft
        />
        </div>
      </div>
    </main>
</PageShell>

<style is:global>
  .prose {
    color: rgb(var(--lightSlate-100));
  }

  .prose h2 {
    color: rgb(var(--lightSlate-50));
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    color: rgb(var(--lightSlate-50));
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .prose p {
    margin-bottom: 1rem;
    line-height: 1.75;
  }

  .prose ul, .prose ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose code {
    background-color: rgb(var(--darkSlate-600));
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }

  .prose pre {
    background-color: rgb(var(--darkSlate-700));
    border: 1px solid rgb(var(--darkSlate-600));
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }

  .prose pre code {
    background: none;
    padding: 0;
    border-radius: 0;
  }

  .prose a {
    color: rgb(var(--primary-400));
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .prose a:hover {
    color: rgb(var(--primary-300));
  }

  .prose strong {
    color: rgb(var(--lightSlate-50));
    font-weight: 600;
  }

  .prose blockquote {
    border-left: 4px solid rgb(var(--primary-500));
    padding-left: 1rem;
    margin-left: 0;
    color: rgb(var(--darkSlate-100));
    font-style: italic;
  }

  .prose img {
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }
</style>
