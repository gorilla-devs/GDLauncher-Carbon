---
import { getLocaleFromUrl, localizedPath } from "../lib/i18n"

const locale = getLocaleFromUrl(Astro.url.pathname)
const homeHref = localizedPath("/", locale)
---

<div class="min-h-screen flex flex-col">
  <div class="flex-1 flex items-center justify-center p-6">
    <div class="bg-darkSlate-800 rounded-xl p-8 md:p-12 max-w-lg text-center">
      <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-red-500/20 flex items-center justify-center">
        <svg class="w-8 h-8 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 7v5l3 3"/>
        </svg>
      </div>

      <h1 class="text-2xl md:text-3xl font-bold text-lightSlate-50 mb-4">
        Account Deletion Scheduled
      </h1>

      <p class="text-darkSlate-100 mb-4">
        Your deletion request is confirmed. Your account and all associated
        data will be permanently deleted on
        <span id="deletion-date" class="font-semibold text-lightSlate-50">the date in your confirmation email</span>.
        Until then, your account keeps working normally.
      </p>

      <p class="text-darkSlate-100 mb-8">
        We've emailed you the exact deletion date. If you change your mind,
        sign in to your GDL account in GDLauncher before that date and cancel
        the deletion from Settings &rarr; Accounts. We're sad to see you go.
      </p>

      <a href={homeHref} class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-primary-500 hover:bg-primary-600 text-lightSlate-50 font-semibold transition-colors">
        Return to Home
      </a>
    </div>
  </div>
</div>

<script>
  const effectiveAt = new URLSearchParams(window.location.search).get(
    "effective_at"
  )
  if (effectiveAt) {
    const date = new Date(effectiveAt)
    if (!Number.isNaN(date.getTime())) {
      const target = document.getElementById("deletion-date")
      if (target) {
        target.textContent = date.toLocaleString(undefined, {
          year: "numeric",
          month: "long",
          day: "numeric",
          hour: "2-digit",
          minute: "2-digit"
        })
      }
    }
  }
</script>
