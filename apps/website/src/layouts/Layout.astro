---
import type { CollectionEntry } from "astro:content";
import PageShell from "../components/PageShell.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, heroImage } = Astro.props;
---

<PageShell
  title={title}
  description={description}
  particles
>
  <Fragment slot="head">
    <style>
      main {
        width: 960px;
        margin: 0 auto;
        padding-top: 4rem;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
      }
    </style>
  </Fragment>

    <main>
      <article>
        <div class="hero-image">
          {
            heroImage && (
              <img width={1020} height={510} src={heroImage} alt="" />
            )
          }
        </div>

        <slot />
      </article>
    </main>
</PageShell>
