---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import "@fontsource/ubuntu";
import "@fontsource/ubuntu/500.css";
import "@fontsource/ubuntu/700.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LoadingBar from "../components/LoadingBar.astro";
import FormattedDate from "../components/FormattedDate.astro";
import ArticleInteractiveMarkdown from "../components/ArticleInteractiveMarkdown";
import Breadcrumb from "../components/Breadcrumb.astro";
import ParticleBackground from "../components/ParticleBackground.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${title} | GDLauncher Blog`} description={description} image={heroImage} />
  </head>

  <body class="bg-darkSlate-900 text-lightSlate-50 min-h-screen">
    <LoadingBar />
    <!-- Background layers -->
    <div class="fixed inset-0 -z-10">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_0%,rgba(43,107,177,0.12),transparent)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
    </div>
    <ParticleBackground />
    <Header />
    <ArticleInteractiveMarkdown client:idle />

    <main class="py-8">
      <Breadcrumb items={[
        { label: "Blog", href: "/blog" },
        { label: title }
      ]} />

      <article>
        <!-- Hero Image -->
        {heroImage && (
          <div class="max-w-4xl mx-auto px-4 mb-8">
            <img
              src={heroImage}
              alt={title}
              class="w-full h-auto rounded-xl shadow-2xl shadow-black/20"
            />
          </div>
        )}

        <!-- Article Container with solid background -->
        <div class="max-w-4xl mx-auto px-4">
          <div class="bg-darkSlate-800 rounded-xl p-8 md:p-10">
            <!-- Article Header -->
            <header class="mb-10">
              <!-- Title -->
              <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-lightSlate-50 leading-tight mb-6">
                {title}
              </h1>

              <!-- Description -->
              {description && (
                <p class="text-xl text-darkSlate-100 mb-6 leading-relaxed">
                  {description}
                </p>
              )}

              <!-- Meta info -->
              <div class="flex flex-wrap items-center gap-4 text-sm text-darkSlate-200">
                <div class="flex items-center gap-2">
                  <div class="i-hugeicons:calendar-03 w-4 h-4"></div>
                  <time datetime={pubDate.toISOString()}>
                    <FormattedDate date={pubDate} />
                  </time>
                </div>
                {updatedDate && (
                  <div class="flex items-center gap-2">
                    <div class="i-hugeicons:refresh w-4 h-4"></div>
                    <span>Updated <FormattedDate date={updatedDate} /></span>
                  </div>
                )}
              </div>
            </header>

            <!-- Article Content -->
            <div id="articleContainer" class="prose prose-invert prose-lg">
              <slot />
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="max-w-4xl mx-auto px-4 mt-16">
          <!-- Download CTA -->
          <div class="bg-gradient-to-r from-primary-600/20 to-primary-800/20 border border-primary-500/30 rounded-xl p-8 text-center">
            <h2 class="text-2xl font-bold text-lightSlate-50 mb-3">
              Ready to Try GDLauncher?
            </h2>
            <p class="text-darkSlate-100 mb-6 max-w-xl mx-auto">
              Download GDLauncher and start playing modded Minecraft in minutes. One-click install for modpacks, mods, and more.
            </p>
            <a
              href="/download/windows"
              data-astro-prefetch="false"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-primary-500 hover:bg-primary-600 text-lightSlate-50 font-semibold transition-colors"
            >
              <div class="i-simple-icons:windows11 w-5 h-5"></div>
              Download GDLauncher
            </a>
          </div>

          <!-- Back to blog -->
          <div class="mt-12 text-center">
            <a
              href="/blog"
              class="inline-flex items-center gap-2 text-darkSlate-100 hover:text-lightSlate-50 transition-colors"
            >
              <div class="i-hugeicons:arrow-left-01 w-5 h-5"></div>
              Back to all posts
            </a>
          </div>
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  .prose {
    color: rgb(var(--lightSlate-100));
  }

  .prose h2 {
    color: rgb(var(--lightSlate-50));
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    color: rgb(var(--lightSlate-50));
    font-size: 1.375rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose h4 {
    color: rgb(var(--lightSlate-50));
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }

  .prose ul, .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose ul {
    list-style-type: disc;
  }

  .prose ol {
    list-style-type: decimal;
  }

  .prose li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .prose code {
    background-color: rgb(var(--darkSlate-600));
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
    font-family: ui-monospace, monospace;
  }

  .prose pre {
    background-color: rgb(var(--darkSlate-700));
    border: 1px solid rgb(var(--darkSlate-600));
    border-radius: 0.75rem;
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .prose pre code {
    background: none;
    padding: 0;
    border-radius: 0;
    font-size: 0.875rem;
  }

  .prose a {
    color: rgb(var(--primary-400));
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .prose a:hover {
    color: rgb(var(--primary-300));
  }

  .prose strong {
    color: rgb(var(--lightSlate-50));
    font-weight: 600;
  }

  .prose blockquote {
    border-left: 4px solid rgb(var(--primary-500));
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: rgb(var(--darkSlate-100));
    font-style: italic;
  }

  .prose img {
    border-radius: 0.75rem;
    margin: 2rem 0;
  }

  .prose hr {
    border: none;
    border-top: 1px solid rgb(var(--darkSlate-600));
    margin: 2.5rem 0;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }

  .prose th, .prose td {
    border: 1px solid rgb(var(--darkSlate-600));
    padding: 0.75rem;
    text-align: left;
  }

  .prose th {
    background-color: rgb(var(--darkSlate-700));
    color: rgb(var(--lightSlate-50));
    font-weight: 600;
  }

  .prose details {
    background-color: rgba(var(--darkSlate-700), 0.5);
    border: 1px solid rgb(var(--darkSlate-600));
    border-radius: 0.75rem;
    padding: 1rem;
    margin-bottom: 1.5rem;
  }

  .prose details summary {
    color: rgb(var(--lightSlate-50));
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .prose details ul {
    margin-top: 1rem;
    margin-bottom: 0;
  }

  .prose details ul li {
    margin-bottom: 0.25rem;
  }

  .prose details ul li a,
  .prose details ul li a:hover {
    color: rgb(var(--darkSlate-100));
    transition: color 0.15s ease;
  }

  .prose details ul li a:hover {
    color: rgb(var(--primary-400)) !important;
  }
</style>
