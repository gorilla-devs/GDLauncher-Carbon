---
import PageShell from "../components/PageShell.astro"
---

<PageShell
  title="Page Not Found - GDLauncher"
  description="The page you're looking for doesn't exist or has been moved."
>
    <div class="min-h-screen flex flex-col">
      <div class="flex-1 flex items-center justify-center p-6">
        <div class="bg-darkSlate-800 rounded-xl p-8 md:p-12 max-w-lg text-center">
          <div class="text-7xl font-bold text-primary-400 mb-4">404</div>

          <h1 class="text-2xl font-bold text-lightSlate-50 mb-3">
            Page Not Found
          </h1>

          <p class="text-darkSlate-100 mb-8">
            The page you're looking for doesn't exist or has been moved.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-primary-500 hover:bg-primary-600 text-lightSlate-50 font-semibold transition-colors">
              Return to Home
            </a>
            <a href="/guides" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-darkSlate-700 hover:bg-darkSlate-600 text-lightSlate-50 font-semibold transition-colors">
              Browse Guides
            </a>
          </div>
        </div>
      </div>
    </div>
</PageShell>
