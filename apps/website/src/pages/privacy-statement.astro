---
import Layout from "../layouts/Layout.astro";
import { marked } from "marked";

const response = await fetch(
  "https://raw.githubusercontent.com/gorilla-devs/ToS-Privacy/master/privacy-statement.md"
);
const data = await response.text();
const md = marked(data);
---

<Layout
  title="Privacy Statement"
  description="gdlauncher privacy statement"
  pubDate={new Date("August 08 2021")}
>
  <div class="bg-darkSlate-800 rounded-xl p-8 md:p-12">
    <div set:html={md} />
  </div>
</Layout>
