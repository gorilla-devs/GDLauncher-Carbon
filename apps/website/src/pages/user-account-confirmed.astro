---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LoadingBar from "../components/LoadingBar.astro";
import "@fontsource/ubuntu";
import { SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Account Verified - GDLauncher"
      description={SITE_DESCRIPTION}
    />
  </head>

  <body class="bg-darkSlate-900 text-lightSlate-50 min-h-screen">
    <LoadingBar />
    <!-- Background layers -->
    <div class="fixed inset-0 -z-10">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_0%,rgba(43,107,177,0.12),transparent)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
    </div>

    <div class="min-h-screen flex flex-col">
      <Header />

      <div class="flex-1 flex items-center justify-center p-6">
        <div class="bg-darkSlate-800 rounded-xl p-8 md:p-12 max-w-lg text-center">
          <!-- Icon -->
          <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-green-500/20 flex items-center justify-center">
            <svg class="w-8 h-8 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12l5 5L20 7"/>
            </svg>
          </div>

          <!-- Heading -->
          <h1 class="text-2xl md:text-3xl font-bold text-lightSlate-50 mb-4">
            Account Verified!
          </h1>

          <!-- Description -->
          <p class="text-darkSlate-100 mb-8">
            Your GDLauncher account has been successfully verified. You can now close this window and return to the launcher.
          </p>

          <!-- CTA Button -->
          <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-primary-500 hover:bg-primary-600 text-lightSlate-50 font-semibold transition-colors">
            Return to Home
          </a>
        </div>
      </div>

      <Footer />
    </div>
  </body>
</html>
