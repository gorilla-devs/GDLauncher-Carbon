---
import type { GetStaticPaths } from "astro"
import AddonInstallLayout from "../../../components/AddonInstallLayout.astro"
import { fetchTopCurseForgeAddons } from "../../../lib/api/curseforge"
import type { AddonInfo } from "../../../lib/api/types"
import { marked } from "marked"

import worldsInstructions from "../../../content/addon-instructions/worlds.md?raw"

export const getStaticPaths: GetStaticPaths = async () => {
  const apiKey = import.meta.env.CURSEFORGE_API_KEY
  if (!apiKey) {
    console.warn("CURSEFORGE_API_KEY not set, skipping CurseForge worlds pages")
    return []
  }

  const limit = import.meta.env.DEV ? 5 : 1000
  const addons = await fetchTopCurseForgeAddons("worlds", apiKey, limit)

  return addons.map((addon) => ({
    params: { slug: addon.slug },
    props: { addon },
  }))
}

interface Props {
  addon: AddonInfo
}

const { addon } = Astro.props
const instructionsHtml = await marked(worldsInstructions)
---

<AddonInstallLayout
  addonName={addon.name}
  addonSlug={addon.slug}
  addonType="worlds"
  platform="curseforge"
  imageUrl={addon.imageUrl}
  websiteUrl={addon.websiteUrl}
>
  <Fragment set:html={instructionsHtml} />
</AddonInstallLayout>
