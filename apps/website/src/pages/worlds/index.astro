---
/**
 * Worlds Hub Page
 */
import BaseHead from "../../components/BaseHead.astro"
import Header from "../../components/Header.astro"
import Footer from "../../components/Footer.astro"
import LoadingBar from "../../components/LoadingBar.astro"
import Breadcrumb from "../../components/Breadcrumb.astro"
import "@fontsource/ubuntu"
import "@fontsource/ubuntu/500.css"
import "@fontsource/ubuntu/700.css"

Astro.locals.cache(300)
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Minecraft Worlds & Maps | GDLauncher"
      description="Browse and download Minecraft worlds and adventure maps from CurseForge. Play community-created maps."
      keywords="minecraft worlds, minecraft maps, adventure maps, curseforge worlds, world downloads, custom maps"
    />
  </head>

  <body class="bg-darkSlate-900 text-lightSlate-50 min-h-screen">
    <LoadingBar />
    <!-- Background layers -->
    <div class="fixed inset-0 -z-10">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_0%,rgba(43,107,177,0.12),transparent)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
    </div>
    <Header />

    <main class="py-8">
      <Breadcrumb items={[{ label: "Worlds" }]} maxWidth="max-w-6xl" />

      <div class="max-w-6xl mx-auto px-4">
      <div class="bg-darkSlate-800 rounded-xl p-8 md:p-12 mb-12">
        <div class="text-center mb-12">
          <h1 class="text-4xl md:text-5xl font-bold text-lightSlate-50 mb-4">
            Minecraft
            <span class="text-primary-300">Worlds & Maps</span>
          </h1>
          <p class="text-darkSlate-100 text-lg max-w-2xl mx-auto">
            Download and play worlds created by the community. From adventure maps to creative showcases,
            explore amazing builds made by other players.
          </p>
        </div>

        <section class="prose prose-invert prose-lg max-w-3xl mx-auto mb-12">
          <h2 class="text-lightSlate-50">What are World Downloads?</h2>
          <p class="text-darkSlate-100">
            World downloads are save files created by other players that you can play on your own computer.
            They contain everything from the original world - builds, items, and configurations.
          </p>
          <p class="text-darkSlate-100">Popular types of world downloads:</p>
          <ul class="text-darkSlate-100">
            <li><strong class="text-lightSlate-50">Adventure Maps</strong> - Story-driven experiences with puzzles and quests</li>
            <li><strong class="text-lightSlate-50">Minigame Maps</strong> - Parkour, PvP arenas, escape rooms</li>
            <li><strong class="text-lightSlate-50">Survival Maps</strong> - Pre-built worlds with unique challenges</li>
            <li><strong class="text-lightSlate-50">Creative Showcases</strong> - Amazing builds to explore</li>
            <li><strong class="text-lightSlate-50">Redstone Contraptions</strong> - Working machines and mechanisms</li>
          </ul>
        </section>

        <section class="prose prose-invert prose-lg max-w-3xl mx-auto mb-12">
          <h2 class="text-lightSlate-50">Compatibility Notes</h2>
          <p class="text-darkSlate-100">
            World downloads work with any Minecraft edition, but keep these things in mind:
          </p>
          <ul class="text-darkSlate-100">
            <li>The world's Minecraft version should match your game version for best results</li>
            <li>Worlds made in newer versions won't open in older versions of Minecraft</li>
            <li>Worlds from older versions will auto-upgrade when opened (this is one-way)</li>
            <li>Modded worlds require the same mods to work properly</li>
            <li>Some maps use command blocks that may behave differently across versions</li>
          </ul>
          <p class="text-darkSlate-100">
            GDLauncher makes installation easy - just browse, click install, and the world is added to your instance.
          </p>
        </section>

        <section class="prose prose-invert prose-lg max-w-3xl mx-auto">
          <h2 class="text-lightSlate-50">Sharing Your Own Worlds</h2>
          <p class="text-darkSlate-100">
            You can share your own worlds with other players:
          </p>
          <ul class="text-darkSlate-100">
            <li>Worlds are stored in your instance's "saves" folder</li>
            <li>Zip the world folder to create a shareable file</li>
            <li>Upload to CurseForge or Planet Minecraft, or share directly with friends</li>
          </ul>
          <p class="text-darkSlate-100">Tips for sharing worlds:</p>
          <ul class="text-darkSlate-100">
            <li>Set a clear spawn point before sharing</li>
            <li>Include version info and any required mods or data packs in the description</li>
            <li>Test the world from a fresh download before publishing</li>
            <li>Consider adding a resource pack if your build relies on specific textures</li>
          </ul>
        </section>
      </div>

      <section class="mb-12">
        <div class="bg-darkSlate-800 rounded-xl overflow-hidden">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            <div class="p-8 lg:p-12">
              <h2 class="text-2xl md:text-3xl font-bold text-lightSlate-50 mb-4">Browse Worlds in GDLauncher</h2>
              <p class="text-darkSlate-100 mb-6">
                Find and download adventure maps and world saves from CurseForge directly in GDLauncher.
                Explore amazing community creations.
              </p>
              <ul class="flex flex-col gap-3 mb-8">
                <li class="flex items-center gap-3 text-darkSlate-50">
                  <svg class="w-5 h-5 text-primary-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>
                  <span>Browse adventure maps and world downloads</span>
                </li>
                <li class="flex items-center gap-3 text-darkSlate-50">
                  <svg class="w-5 h-5 text-primary-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>
                  <span>One-click install to any instance</span>
                </li>
                <li class="flex items-center gap-3 text-darkSlate-50">
                  <svg class="w-5 h-5 text-primary-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>
                  <span>Manage multiple worlds per instance</span>
                </li>
              </ul>
              <a href="/download/windows" data-astro-prefetch="false" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-primary-500 hover:bg-primary-600 text-lightSlate-50 font-semibold transition-colors transition-transform duration-100 ease-spring active:scale-95">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M3 12V6.75l6-1.32v6.48L3 12zm17-9v8.75l-10 .15V5.21L20 3zM3 13l6 .09v6.81l-6-1.15V13zm17 .25V22l-10-1.91V13.1l10 .15z"/></svg>
                Download GDLauncher
              </a>
            </div>
            <div class="relative">
              <img
                src="https://cdn.gdl.gg/assets/website-browse-worlds.jpg"
                alt="GDLauncher world browser interface"
                class="w-full h-auto"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </section>

      <section class="mt-8 bg-darkSlate-800 rounded-xl p-8 md:p-12">
        <h2 class="text-2xl font-bold text-lightSlate-50 mb-6 text-center">Learn More</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-2xl mx-auto">
          <a href="/guides/install-worlds" class="p-4 rounded-lg bg-darkSlate-700/50 hover:bg-darkSlate-700 transition-colors transition-transform duration-100 ease-spring active:scale-98">
            <span class="text-lightSlate-50 font-medium">How to Install Worlds</span>
          </a>
          <a href="/guides/install-modpack" class="p-4 rounded-lg bg-darkSlate-700/50 hover:bg-darkSlate-700 transition-colors transition-transform duration-100 ease-spring active:scale-98">
            <span class="text-lightSlate-50 font-medium">How to Install Modpacks</span>
          </a>
        </div>
      </section>
      </div>
    </main>

    <Footer />
  </body>
</html>
