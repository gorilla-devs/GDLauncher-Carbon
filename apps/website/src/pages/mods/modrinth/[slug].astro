---
import type { GetStaticPaths } from "astro"
import AddonInstallLayout from "../../../components/AddonInstallLayout.astro"
import type { AddonInfo } from "../../../lib/api/types"
import { marked } from "marked"
import addonsData from "../../../lib/addonsData"

import modsInstructions from "../../../content/addon-instructions/mods.md?raw"

export const getStaticPaths: GetStaticPaths = async () => {
  return addonsData.modrinth.mods.map((addon) => ({
    params: { slug: addon.slug },
    props: { addon: { ...addon, platform: "modrinth" as const, type: "mods" as const } },
  }))
}

interface Props {
  addon: AddonInfo
}

const { addon } = Astro.props
const instructionsHtml = marked(modsInstructions)
---

<AddonInstallLayout
  addonName={addon.name}
  addonSlug={addon.slug}
  addonType="mods"
  platform="modrinth"
  imageUrl={addon.imageUrl}
  websiteUrl={addon.websiteUrl}
  description={addon.description}
  authors={addon.authors}
  author={addon.author}
  categories={addon.categories}
  dateModified={addon.dateModified}
>
  <Fragment set:html={instructionsHtml} />
</AddonInstallLayout>
