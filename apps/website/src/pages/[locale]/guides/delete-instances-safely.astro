---
import GuideLayout from "../../../components/GuideLayout.astro"
import type { GetStaticPaths } from "astro"
import { LOCALES, DEFAULT_LOCALE, type Locale,
  localizeInternalLinks,
} from "../../../lib/i18n"

export const getStaticPaths: GetStaticPaths = () =>
  LOCALES
    .filter((loc) => loc !== DEFAULT_LOCALE)
    .map((loc) => ({ params: { locale: loc } }))

const { locale } = Astro.params as { locale: Exclude<Locale, "en"> }

interface Step { name: string; text: string }
interface Meta { title: string; description: string; steps: Step[] }

const meta: Record<Exclude<Locale, "en">, Meta> = {
  ja: {
    title: "GDLauncher でインスタンスを安全に削除する方法",
    description: "1 つ / 複数の Minecraft インスタンスを削除、削除されるもの、残るもの、誤削除からの回復。",
    steps: [
      { name: "インスタンスを右クリック", text: "Library で削除したいインスタンスを右クリックし Delete (ゴミ箱アイコン)。" },
      { name: "モーダルで確認", text: "ConfirmInstanceDeletion モーダルが確認を求めます。インスタンス名が表示されるので正しいものを削除しているかダブルチェック。" },
      { name: "削除完了を待つ", text: "GDLauncher がディスクからインスタンスフォルダーを削除しデータベース行も除去。大型 Modpack なら数秒。" }
    ]
  },
  ko: {
    title: "GDLauncher에서 인스턴스 안전하게 삭제하는 법",
    description: "단일 또는 다중 Minecraft 인스턴스 제거, 무엇이 삭제되고 무엇이 남는지, 실수로 삭제 시 복구 방법.",
    steps: [
      { name: "인스턴스 오른쪽 클릭", text: "Library에서 삭제할 인스턴스를 오른쪽 클릭하고 Delete(휴지통 아이콘) 선택." },
      { name: "모달에서 확인", text: "ConfirmInstanceDeletion 모달이 확인을 요구. 인스턴스 이름이 표시되어 올바른 걸 삭제하는지 다시 확인 가능." },
      { name: "삭제 완료 대기", text: "GDLauncher가 디스크에서 인스턴스 폴더와 DB 행을 제거. 대형 모드팩은 몇 초." }
    ]
  },
  de: {
    title: "Instanzen in GDLauncher sicher löschen",
    description: "Eine oder mehrere Minecraft-Instanzen entfernen, was gelöscht und was behalten wird, und wie du nach versehentlichem Löschen wiederherstellst.",
    steps: [
      { name: "Rechtsklick auf die Instanz", text: "In der Library Rechtsklick auf die zu löschende Instanz, Delete wählen (Mülleimer-Icon)." },
      { name: "Im Modal bestätigen", text: "Das ConfirmInstanceDeletion-Modal fragt nach Bestätigung. Der Instanzname wird gezeigt, so dass du sicher die richtige löschst." },
      { name: "Auf die Löschung warten", text: "GDLauncher entfernt den Instanz-Ordner von der Platte und die Datenbankzeile. Bei großen Modpacks dauert das wenige Sekunden." }
    ]
  },
  fr: {
    title: "Comment supprimer des instances en toute sécurité dans GDLauncher",
    description: "Retire une ou plusieurs instances Minecraft, ce qui est supprimé, ce qui est gardé, et comment récupérer après une suppression accidentelle.",
    steps: [
      { name: "Clic droit sur l'instance", text: "Dans la Library, clic droit sur l'instance à supprimer et choisis Delete (icône poubelle)." },
      { name: "Confirmer dans le modal", text: "Le modal ConfirmInstanceDeletion demande confirmation. Il affiche le nom de l'instance pour que tu puisses vérifier que c'est la bonne." },
      { name: "Attendre la suppression", text: "GDLauncher retire le dossier de l'instance du disque et la ligne en base de données. Pour les gros modpacks, ça prend quelques secondes." }
    ]
  },
  es: {
    title: "Cómo borrar instancias con seguridad en GDLauncher",
    description: "Elimina una o varias instancias de Minecraft, qué se borra, qué se queda y cómo recuperar de un borrado accidental.",
    steps: [
      { name: "Clic derecho en la instancia", text: "En la Library, clic derecho en la instancia a borrar y elige Delete (icono papelera)." },
      { name: "Confirmar en el modal", text: "El modal ConfirmInstanceDeletion pide confirmación. Muestra el nombre de la instancia para que verifiques que es la correcta." },
      { name: "Esperar el borrado", text: "GDLauncher quita la carpeta de la instancia del disco y la fila de la base de datos. Para modpacks grandes tarda algunos segundos." }
    ]
