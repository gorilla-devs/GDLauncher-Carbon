    steps: [
      { name: "Clic droit sur l'instance", text: "Dans la Library, clic droit sur l'instance dont tu as besoin des fichiers." },
      { name: "Ouvrir More Options", text: "Survole More Options pour étendre le sous-menu." },
      { name: "Cliquer Open Folder", text: "Choisis Open Folder (icône folder-open). L'explorateur de fichiers OS s'ouvre à la racine de l'instance." }
