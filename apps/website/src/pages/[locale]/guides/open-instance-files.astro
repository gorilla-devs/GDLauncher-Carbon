---
import GuideLayout from "../../../components/GuideLayout.astro"
import type { GetStaticPaths } from "astro"
import { LOCALES, DEFAULT_LOCALE, type Locale,
  localizeInternalLinks,
} from "../../../lib/i18n"

export const getStaticPaths: GetStaticPaths = () =>
  LOCALES
    .filter((loc) => loc !== DEFAULT_LOCALE)
    .map((loc) => ({ params: { locale: loc } }))

const { locale } = Astro.params as { locale: Exclude<Locale, "en"> }

interface Step { name: string; text: string }
interface Meta { title: string; description: string; steps: Step[] }

const meta: Record<Exclude<Locale, "en">, Meta> = {
  ja: {
    title: "GDLauncher でインスタンスのファイルを開く方法",
    description: "OS のファイルマネージャーでインスタンスフォルダーへ移動。ワールドのコピー、設定の手動編集、スクリーンショットの取り出しなど。",
    steps: [
      { name: "インスタンスを右クリック", text: "Library でファイルが必要なインスタンスを右クリック。" },
      { name: "More Options を開く", text: "More Options にホバーしてサブメニューを表示。" },
      { name: "Open Folder をクリック", text: "Open Folder (folder-open アイコン) を選択。OS のファイルマネージャーがインスタンスルートを開きます。" }
