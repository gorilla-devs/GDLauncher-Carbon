---
import GuideLayout from "../../../components/GuideLayout.astro"
import type { GetStaticPaths } from "astro"
import { LOCALES, DEFAULT_LOCALE, type Locale,
  localizeInternalLinks,
} from "../../../lib/i18n"

export const getStaticPaths: GetStaticPaths = () =>
  LOCALES
    .filter((loc) => loc !== DEFAULT_LOCALE)
    .map((loc) => ({ params: { locale: loc } }))

const { locale } = Astro.params as { locale: Exclude<Locale, "en"> }

interface Step { name: string; text: string }
interface Meta { title: string; description: string; steps: Step[] }

const meta: Record<Exclude<Locale, "en">, Meta> = {
  ja: {
    title: "GDLauncher のデータを別のドライブに移す方法",
    description: "GDLauncher の Runtime Path を変更して、全インスタンス、アセット、ライブラリ、ランチャーデータベースを別のドライブ / フォルダーに移動。マイグレーションは自動。",
    steps: [
      { name: "Runtime Path 設定を開く", text: "GDLauncher を開き Settings → Runtime Path。現在の場所が入力欄に表示。対象ドライブを選ぶとシステム情報も表示。" },
      { name: "新しいパスを入力", text: "新しい場所を入力 (例: Windows なら D:\\gdlauncher-data、Linux なら /mnt/data/gdlauncher)、またはフォルダーアイコンから選択。フォルダーは存在不要、GDLauncher が必要に応じて作成。" },
      { name: "変更を確定", text: "パスが有効なら Apply ボタンが有効に。クリックしてモーダルで確認。対象フォルダーにすでに GDLauncher データがあれば (以前の移動から) そのまま使用、なければ既存データをマイグレーション。" },
      { name: "マイグレーション待ち", text: "GDLauncher が再起動して全画面モーダル (スキャン / コピー / 削除フェーズと進行バー) を表示。途中でアプリやマシンを終了しないでください。所要時間はデータサイズ依存、空の場合は数秒、数百 GB なら 30 分程度。" },
      { name: "確認とクリーンアップ", text: "再起動後、Settings → Runtime Path に新しい場所が表示されているか確認。既存インスタンスを起動して動作確認。古い場所の runtime_path_override マーカーファイルは GDLauncher が移動を追跡するのに使うので、正常起動を 1 回確認するまでは残しておいてください。" }
    ]
  },
  ko: {
    title: "GDLauncher의 데이터를 다른 드라이브로 옮기는 법",
    description: "GDLauncher의 Runtime Path를 변경해 모든 인스턴스, 에셋, 라이브러리, 런처 데이터베이스를 다른 드라이브나 폴더로 이동. 마이그레이션은 자동.",
    steps: [
      { name: "Runtime Path 설정 열기", text: "GDLauncher를 열고 Settings → Runtime Path. 현재 위치가 입력란에 표시; 대상 드라이브를 고르면 시스템 정보도 보입니다." },
      { name: "새 경로 입력", text: "새 위치를 입력(예: Windows에선 D:\\gdlauncher-data, Linux에선 /mnt/data/gdlauncher), 또는 폴더 아이콘으로 탐색. 폴더가 미리 존재할 필요는 없습니다, GDLauncher가 필요 시 만듭니다." },
      { name: "변경 확정", text: "경로가 유효해지면 Apply 버튼이 활성. 클릭하고 모달에서 확인. 대상 폴더에 이미 GDLauncher 데이터가 있으면(이전 이동에서) 그대로 사용; 아니면 기존 데이터를 마이그레이션." },
      { name: "마이그레이션 기다리기", text: "GDLauncher가 재시작되어 스캔/복사/정리 단계와 진행 바를 가진 전체 화면 모달이 뜹니다. 도중에 앱이나 컴퓨터를 종료하지 마세요. 시간은 데이터 크기에 따라, 빈 설치는 몇 초, 수백 GB는 30분." },
      { name: "확인과 정리", text: "재시작 후 Settings → Runtime Path가 새 위치를 보이는지 확인. 기존 인스턴스를 실행해 동작 확인. 옛 위치의 runtime_path_override 마커 파일은 GDLauncher가 이동을 추적하는 데 씁니다, 한 번 성공적으로 실행할 때까지 남겨 두세요." }
    ]
  },
  de: {
    title: "GDLauncher-Daten auf ein anderes Laufwerk verschieben",
    description: "Den Runtime Path von GDLauncher ändern, um alle Instanzen, Assets, Libraries und die Launcher-Datenbank auf ein anderes Laufwerk oder einen anderen Ordner zu verschieben. Migration läuft automatisch.",
    steps: [
      { name: "Runtime-Path-Settings öffnen", text: "GDLauncher öffnen, Settings → Runtime Path. Der aktuelle Pfad steht im Eingabefeld; wählst du ein Ziel, zeigt die Seite auch System-Info dazu." },
      { name: "Neuen Pfad eintragen", text: "Neuen Ort eintippen (z. B. D:\\gdlauncher-data auf Windows oder /mnt/data/gdlauncher auf Linux), oder per Ordner-Icon browsen. Der Ordner muss noch nicht existieren, GDLauncher legt ihn bei Bedarf an." },
      { name: "Änderung bestätigen", text: "Wenn der Pfad gültig ist, wird der Apply-Button aktiv. Klicken und im Modal bestätigen. Hat der Zielordner schon GDLauncher-Daten (von einem früheren Move), nutzt GDLauncher die direkt; sonst migriert er die bestehenden." },
      { name: "Auf die Migration warten", text: "GDLauncher startet neu in einen Vollbild-Dialog mit Scan-, Kopier- und Cleanup-Phase plus Fortschrittsbalken. App und PC währenddessen nicht schließen. Dauer hängt an der Datenmenge, von Sekunden bei leerer Installation bis zu einer halben Stunde bei mehreren hundert GB." },
      { name: "Verifizieren und aufräumen", text: "Nach Neustart in Settings → Runtime Path den neuen Ort prüfen. Eine bestehende Instanz starten, ob alles noch geht. Die runtime_path_override-Marker-Datei am alten Ort hilft GDLauncher, den Umzug zu tracken; lass sie liegen, bis du einmal erfolgreich gestartet hast." }
    ]
  },
  fr: {
    title: "Comment déplacer les données de GDLauncher sur un autre disque",
    description: "Change le Runtime Path de GDLauncher pour déplacer toutes les instances, assets, bibliothèques et la base de données du launcher vers un autre disque ou dossier. La migration est gérée automatiquement.",
    steps: [
      { name: "Ouvrir les settings Runtime Path", text: "Ouvre GDLauncher et va dans Settings → Runtime Path. L'emplacement actuel est dans le champ ; la page affiche aussi les infos système du disque cible quand tu en choisis un." },
      { name: "Saisir le nouveau chemin", text: "Tape le nouvel emplacement (par exemple D:\\gdlauncher-data sur Windows ou /mnt/data/gdlauncher sur Linux), ou clique l'icône dossier pour parcourir. Le dossier n'a pas besoin d'exister, GDLauncher le crée si nécessaire." },
      { name: "Confirmer le changement", text: "Quand le chemin est valide, le bouton Apply s'active. Clique-le et confirme dans le modal. Si le dossier cible contient déjà des données GDLauncher (d'un déplacement précédent), GDLauncher l'utilise tel quel ; sinon il migre les données existantes." },
      { name: "Attendre la migration", text: "GDLauncher redémarre dans un modal plein écran avec phases scan / copie / nettoyage et barre de progression. Ne ferme ni l'app ni la machine pendant. Le temps dépend de la taille des données, de quelques secondes pour une install vide à une demi-heure pour des centaines de Go." },
      { name: "Vérifier et nettoyer", text: "Après redémarrage, vérifie que Settings → Runtime Path affiche le nouvel emplacement. Lance une instance existante pour confirmer que tout marche encore. Le fichier marqueur runtime_path_override à l'ancien emplacement aide GDLauncher à tracer le déplacement ; laisse-le jusqu'à avoir lancé avec succès une fois." }
    ]
  },
  es: {
    title: "Cómo mover los datos de GDLauncher a otro disco",
    description: "Cambia el Runtime Path de GDLauncher para mover todas las instancias, assets, bibliotecas y la base de datos del launcher a otro disco o carpeta. La migración se hace sola.",
    steps: [
      { name: "Abrir ajustes Runtime Path", text: "Abre GDLauncher y ve a Settings → Runtime Path. La ubicación actual aparece en el campo de entrada; la página también muestra info del sistema del disco destino cuando eliges uno." },
      { name: "Introducir el nuevo path", text: "Escribe la nueva ubicación (por ejemplo D:\\gdlauncher-data en Windows o /mnt/data/gdlauncher en Linux), o pulsa el icono de carpeta para navegar. La carpeta no tiene que existir, GDLauncher la crea si hace falta." },
      { name: "Confirmar el cambio", text: "Cuando el path es válido se activa el botón Apply. Pulsa y confirma en el modal. Si la carpeta destino ya tiene datos de GDLauncher (de un movimiento previo), GDLauncher la usa tal cual; si no, migra los datos existentes." },
      { name: "Esperar la migración", text: "GDLauncher reinicia a un modal a pantalla completa con fases escaneo / copia / limpieza y barra de progreso. No cierres la app ni apagues el equipo durante. El tiempo depende del tamaño de datos, desde segundos en una instalación vacía hasta media hora en cientos de GB." },
      { name: "Verificar y limpiar", text: "Tras reiniciar, comprueba que Settings → Runtime Path muestra la nueva ubicación. Lanza una instancia existente para confirmar que todo sigue funcionando. El archivo marcador runtime_path_override en la ubicación antigua ayuda a GDLauncher a rastrear el movimiento; déjalo hasta haber arrancado con éxito al menos una vez." }
    ]
  },
  "pt-BR": {
    title: "Como mover os dados do GDLauncher pra outro drive",
    description: "Mude o Runtime Path do GDLauncher pra mover todas as instâncias, assets, libraries e o banco do launcher pra outro drive ou pasta. A migração é automática.",
    steps: [
      { name: "Abrir ajustes Runtime Path", text: "Abra o GDLauncher e vá em Settings → Runtime Path. O local atual aparece no campo; a página também mostra info de sistema do drive de destino quando você escolhe um." },
      { name: "Digitar o novo caminho", text: "Digite o novo local (por exemplo D:\\gdlauncher-data no Windows ou /mnt/data/gdlauncher no Linux), ou clique no ícone de pasta pra procurar. A pasta não precisa existir, o GDLauncher cria se necessário." },
      { name: "Confirmar a mudança", text: "Quando o caminho é válido, o botão Apply ativa. Clique e confirme no modal. Se a pasta destino já tem dados do GDLauncher (de um movimento anterior), o GDLauncher usa do jeito que está; senão, migra os dados existentes." },
      { name: "Esperar a migração", text: "O GDLauncher reinicia num modal de tela cheia com fases scan / cópia / cleanup e barra de progresso. Não feche a app nem desligue o computador durante. O tempo depende do tamanho dos dados, de segundos numa instalação vazia até meia hora pra centenas de GB." },
      { name: "Verificar e limpar", text: "Após reiniciar, confirme que Settings → Runtime Path mostra o novo local. Lance uma instância existente pra confirmar que tudo ainda funciona. O arquivo marcador runtime_path_override no local antigo ajuda o GDLauncher a rastrear o movimento; deixe até ter lançado com sucesso pelo menos uma vez." }
    ]
  },
  it: {
    title: "Come spostare i dati di GDLauncher su un altro disco",
    description: "Cambia il Runtime Path di GDLauncher per spostare tutte le istanze, asset, librerie e il database del launcher su un altro disco o cartella. La migrazione è automatica.",
    steps: [
      { name: "Apri le impostazioni Runtime Path", text: "Apri GDLauncher e vai su Settings → Runtime Path. La posizione attuale è nel campo, la pagina mostra anche le info di sistema del disco di destinazione quando ne scegli uno." },
      { name: "Inserisci il nuovo percorso", text: "Digita la nuova posizione (per esempio D:\\gdlauncher-data su Windows o /mnt/data/gdlauncher su Linux), oppure clicca l'icona della cartella per sfogliare. La cartella non deve preesistere, GDLauncher la crea se serve." },
      { name: "Conferma la modifica", text: "Quando il percorso è valido, il pulsante Apply si attiva. Cliccalo e conferma nel modal. Se la cartella di destinazione contiene già dati di GDLauncher (da uno spostamento precedente), GDLauncher li usa così come sono, altrimenti migra i dati esistenti." },
      { name: "Attendi la migrazione", text: "GDLauncher si riavvia in un modal a schermo intero con fasi scan/copia/cleanup e barra di progresso. Non chiudere l'app né il computer durante. La durata dipende dalla quantità di dati, da pochi secondi su un'installazione vuota fino a mezz'ora per centinaia di GB." },
      { name: "Verifica e pulisci", text: "Dopo il riavvio, controlla che Settings → Runtime Path mostri la nuova posizione. Avvia un'istanza esistente per confermare che funzioni ancora tutto. Il file marker runtime_path_override nella vecchia posizione serve a GDLauncher per tracciare lo spostamento, lascialo lì finché non hai avviato con successo almeno una volta." }
    ]
  }
}
const m = meta[locale]

const body: Record<Exclude<Locale, "en">, { headings: string[]; paras: string[] }> = {
  ja: {
    headings: ["移動されるもの", "予想されるサイズ", "すでに手動で移動済みの場合", "マイグレーション失敗時", "runtime_path_override マーカー", "プレイ中に Runtime Path を同期しない"],
    paras: [
      "Runtime Path 内のすべて: インスタンス (Mod、ワールド、設定)、Minecraft 共有アセット、Minecraft 共有ライブラリ、GDLauncher がダウンロードした Java、ランチャーデータベース、アプリ全体ログ。要するに GDLauncher がマシン上で生成した重いものすべて。移動しないもの: App Data Path (ウィンドウ状態、Electron キャッシュ、トップレベル設定)。OS 標準位置に残り、通常触ることはありません。",
      "インスタンスなしのクリーンインストールは約 1 GB (Minecraft アセットと Java インストールがほぼ)。各 Modpack はおおよそその自身のダウンロードサイズ分追加され、大きな Pack を数個入れれば 50 GB 超に。OS のファイルマネージャーで現在のデータパスのサイズを確認すれば、マイグレーション時間を見積もれます。",
      "<code>gdlauncher_carbon/data</code> を手動で別の場所にコピーした場合 (Settings を経由せず)、GDLauncher を新しい場所に向けられます。すでに有効な GDLauncher データが入っているパスを入力するとマイグレーションがスキップされ、GDLauncher は設定だけ更新。別マシンへ移動してから新規インストールで移行済みデータを指す場合に便利。",
      "問題があれば進行モーダルにエラーが表示されます。よくある原因: 対象ドライブの容量不足 (ソースデータと同等以上の空きが必要、エラーには不足バイト数が記載)。権限拒否 (Windows では Program Files や C:\\ ルートに管理者権限必要、Linux/macOS では所有パスでなければならない、ユーザー所有フォルダーを選択)。対象が読み取り専用 (一部のネットワークドライブは読み取り専用でマウント、GDLauncher 外で先にファイル作成可能か確認)。マイグレーション失敗後、GDLauncher は元の場所にフォールバックしエラーを表示。詳細は <code>__gdl_logs__</code> 内のファイルで読めます。",
      "移動成功後、GDLauncher は <strong>App Data Path</strong> (Runtime Path 内ではない) に <code>runtime_path_override</code> という小さなテキストファイルを書きます。内容は新しい Runtime Path。各起動でこのファイルを読み、データがどこにあるかを判定。誤って削除すると、ランチャーはデフォルト位置にフォールバックし、移動したデータは Settings → Runtime Path で移動先フォルダーを再指定するまで見えません (「すでに使用中」と認識され、コピーなしで切替)。",
      "OneDrive、iCloud、Dropbox などは GDLauncher とファイルハンドルで競合します。Runtime Path がこれらが積極的に同期するフォルダー内にあると、奇妙な「ファイル使用中」エラーや、たまにセーブ破損が発生。連続同期するドライブではなく、オフラインバックアップされるドライブ (スナップショット、restic、Backblaze など) に Runtime Path を置いてください。"
    ]
  },
  ko: {
    headings: ["이동되는 것", "예상 크기", "이미 수동으로 이동한 경우", "마이그레이션이 실패하면", "runtime_path_override 마커", "플레이 중 Runtime Path 동기화 금지"],
    paras: [
      "Runtime Path 안의 모든 것: 인스턴스(모드, 월드, 설정), Minecraft 공유 에셋, Minecraft 공유 라이브러리, GDLauncher가 다운로드한 Java, 런처 데이터베이스, 앱 전역 로그. 본질적으로 GDLauncher가 머신에 만든 모든 무거운 것. 이동하지 않는 것: App Data Path(창 상태, Electron 캐시, 최상위 설정). OS 표준 위치에 남고 보통 건드리지 않습니다.",
      "인스턴스 없는 깨끗한 설치는 약 1 GB(주로 Minecraft 에셋과 Java 설치). 각 모드팩은 대략 자신의 다운로드 크기만큼 추가하므로 큰 팩 몇 개면 50 GB를 넘기기 쉽습니다. OS 파일 매니저에서 현재 데이터 경로 크기를 보면 마이그레이션 시간을 짐작할 수 있습니다.",
      "<code>gdlauncher_carbon/data</code>를 Settings를 거치지 않고 손으로 다른 위치에 복사했다면 GDLauncher를 새 위치로 가리킬 수 있습니다. 유효한 GDLauncher 데이터가 이미 있는 경로를 입력하면 마이그레이션이 건너뛰어지고 GDLauncher는 설정만 갱신. 다른 머신으로 옮긴 뒤 새 설치가 이주된 데이터를 가리키게 할 때 유용.",
      "도중에 문제가 생기면 진행 모달에 에러가 나타납니다. 흔한 원인: 대상 드라이브 공간 부족(소스 데이터와 같은 정도의 빈 공간이 필요, 에러 메시지에 부족 바이트 표시). 권한 거부(Windows에서 Program Files나 C:\\ 루트는 관리자 권한 필요, Linux/macOS에서는 사용자 소유 경로여야 함; 사용자 소유 폴더 선택). 대상이 읽기 전용(일부 네트워크 드라이브는 기본 읽기 전용으로 마운트; GDLauncher 외부에서 그곳에 파일을 만들 수 있는지 먼저 확인). 마이그레이션 실패 후 GDLauncher는 원래 위치로 폴백하고 에러 메시지를 표시합니다. 자세한 건 <code>__gdl_logs__</code>의 파일에서 볼 수 있습니다.",
      "성공적인 이동 후 GDLauncher는 <strong>App Data Path</strong>(Runtime Path 안이 아니라) 안에 <code>runtime_path_override</code>라는 작은 텍스트 파일을 씁니다. 내용은 새 Runtime Path. 매 실행마다 이 파일을 읽어 데이터 위치를 파악합니다. 실수로 지우면 런처가 기본 위치로 폴백하고, Settings → Runtime Path에서 옮긴 폴더를 다시 가리킬 때까지 옮긴 데이터를 보지 못합니다('이미 사용 중'으로 인식되어 복사 없이 전환).",
      "OneDrive, iCloud, Dropbox 등은 파일 핸들을 두고 GDLauncher와 경쟁합니다. Runtime Path가 이런 도구들이 적극적으로 동기화하는 폴더 안에 있으면 이상한 '파일 사용 중' 오류와 가끔의 세이브 손상이 발생합니다. 연속 동기화되는 드라이브가 아니라 오프라인 백업되는 드라이브(스냅샷, restic, Backblaze 등)에 Runtime Path를 두세요."
    ]
  },
  de: {
    headings: ["Was alles mit umzieht", "Welche Größe zu erwarten ist", "Wenn du Daten schon manuell verschoben hast", "Wenn die Migration scheitert", "Die runtime_path_override-Markerdatei", "Den Runtime Path während des Spielens nicht syncen"],
    paras: [
      "Alles, was im Runtime Path liegt: Instanzen (Mods, Welten, Configs), Minecrafts gemeinsame Assets, Minecrafts gemeinsame Libraries, von GDLauncher heruntergeladene Java-Installs, die Launcher-Datenbank und app-weite Logs. Im Grunde alles Schwere, was GDLauncher auf deiner Maschine erzeugt hat. Nicht mit umzieht: der App Data Path (Fensterzustand, Electron-Cache, Top-Level-Config). Bleibt am OS-Standardort und musst du normalerweise nie anfassen.",
      "Eine saubere Installation ohne Instanzen ist um die 1 GB (vor allem Minecraft-Assets und ein Java-Install). Jedes Modpack legt grob seine eigene Downloadgröße drauf, ein paar große Packs kommen schnell über 50 GB. Schau die Größe deines aktuellen Datenpfads im OS-Dateimanager an, um die Migrationsdauer einzuschätzen.",
      "Hast du <code>gdlauncher_carbon/data</code> per Hand woanders hingekopiert (ohne den Settings-Weg), kannst du GDLauncher auf den neuen Ort zeigen lassen. Wenn du einen Pfad eingibst, der schon gültige GDLauncher-Daten enthält, wird die Migration übersprungen und GDLauncher passt nur die Config an. Praktisch für den Wechsel auf eine andere Maschine, wo eine frische Installation auf die migrierten Daten zeigen soll.",
