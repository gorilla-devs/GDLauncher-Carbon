---
/**
 * Localized "How to Allocate More RAM to a Minecraft Server" guide.
 */
import GuideLayout from "../../../components/GuideLayout.astro"
import type { GetStaticPaths } from "astro"
import { LOCALES, DEFAULT_LOCALE, type Locale,
  localizedPath,
} from "../../../lib/i18n"

export const getStaticPaths: GetStaticPaths = () =>
  LOCALES
    .filter((loc) => loc !== DEFAULT_LOCALE)
    .map((loc) => ({ params: { locale: loc } }))

const { locale } = Astro.params as { locale: Exclude<Locale, "en"> }

interface Step { name: string; text: string }
interface Meta { title: string; description: string; steps: Step[] }

const meta: Record<Exclude<Locale, "en">, Meta> = {
  ja: {
    title: "Minecraft サーバーへの RAM 割り当てを増やす方法",
    description: "GDLauncher の Minecraft サーバーに割り当てるメモリを増やし、プレイヤー数や Mod、チャンク負荷に対応できるようにします。",
    steps: [
      { name: "Library でサーバーを開く", text: "GDLauncher の Servers (または Library) からサーバーを選んで開きます。" },
      { name: "サーバーの Settings を開く", text: "上部の歯車アイコンをクリック (またはサーバーを右クリック → Settings)。" },
      { name: "Maximum RAM スライダーを調整", text: "Maximum RAM を 256 MiB 刻みで調整します。UI の上限は、システム RAM を MiB 単位で切り捨てた値と 32768 MiB (32 GiB) の小さい方です。80% を超えると警告が出ますが、80% で制限されるわけではありません。" },
      { name: "保存", text: "確定するとサーバーの起動引数に書き込まれます。" },
      { name: "サーバーを再起動", text: "実行中なら停止してから再起動。RAM の変更は次回起動時に反映されます。" }
    ]
  },
  ko: {
    title: "Minecraft 서버에 RAM을 더 할당하는 방법",
    description: "GDLauncher의 Minecraft 서버에 할당할 메모리를 늘려 더 많은 플레이어, 모드, 청크 부하를 처리할 수 있게 합니다.",
    steps: [
      { name: "Library에서 서버 열기", text: "GDLauncher의 Servers(또는 Library)에서 서버를 골라 엽니다." },
      { name: "서버 Settings 열기", text: "상단의 톱니 아이콘 클릭(또는 서버 오른쪽 클릭 → Settings)." },
      { name: "Maximum RAM 슬라이더 조정", text: "Maximum RAM을 256 MiB 단위로 조정하세요. UI 상한은 시스템 RAM을 MiB로 내림한 값과 32768 MiB(32 GiB) 중 작은 값입니다. 80%를 초과하면 경고가 표시되지만 80%에서 제한되지는 않습니다." },
      { name: "저장", text: "확인을 누르면 서버의 실행 인수에 적용됩니다." },
      { name: "서버 재시작", text: "실행 중이면 중지하고 다시 실행하세요. RAM 변경은 다음 시작 때 적용됩니다." }
    ]
  },
  de: {
    title: "Mehr RAM für einen Minecraft-Server zuweisen",
    description: "Erhöh den Speicher, der einem Minecraft-Server im GDLauncher zur Verfügung steht, für mehr Spieler, mehr Mods und schwerere Chunk-Last.",
    steps: [
      { name: "Server in der Library öffnen", text: "Im GDLauncher unter Servers (oder Library) den Server auswählen und öffnen." },
      { name: "Server-Settings öffnen", text: "Oben auf das Zahnrad-Icon klicken (oder rechtsklick auf den Server → Settings)." },
      { name: "Maximum-RAM-Regler anpassen", text: "Stelle Maximum RAM in Schritten von 256 MiB ein. Das UI-Maximum ist der kleinere Wert aus dem auf ganze MiB abgerundeten System-RAM und 32768 MiB (32 GiB). Über 80% erscheint eine Warnung; 80% ist keine Begrenzung." },
      { name: "Speichern", text: "Bestätigen. Der neue Wert landet in den Startparametern des Servers." },
      { name: "Server neu starten", text: "Wenn er läuft, stoppen und neu starten. RAM-Änderungen greifen erst beim nächsten Start." }
    ]
  },
  fr: {
    title: "Comment allouer plus de RAM à un serveur Minecraft",
    description: "Augmente la mémoire dispo pour un serveur Minecraft dans GDLauncher pour gérer plus de joueurs, plus de mods et plus de chunks.",
    steps: [
      { name: "Ouvrir le serveur dans la Library", text: "Dans GDLauncher, va dans Servers (ou Library), sélectionne le serveur et ouvre-le." },
      { name: "Ouvrir les Settings du serveur", text: "Clique sur la roue dentée en haut (ou clic droit sur le serveur → Settings)." },
      { name: "Régler le slider Maximum RAM", text: "Règle Maximum RAM par pas de 256 MiB. Le maximum de l’interface est le plus petit entre la RAM système arrondie vers le bas en MiB et 32768 MiB (32 GiB). Au-delà de 80%, un avertissement apparaît ; 80% n’est pas une limite." },
      { name: "Sauvegarder", text: "Confirme. La nouvelle valeur est écrite dans les arguments de lancement du serveur." },
      { name: "Redémarrer le serveur", text: "S'il tourne, stoppe-le puis relance. Le changement de RAM s'applique au prochain démarrage." }
    ]
  },
  es: {
    title: "Cómo asignar más RAM a un servidor de Minecraft",
    description: "Aumenta la memoria disponible para un servidor de Minecraft en GDLauncher para soportar más jugadores, más mods y mayor carga de chunks.",
    steps: [
      { name: "Abrir el servidor en la Library", text: "En GDLauncher, ve a Servers (o Library), selecciona el servidor y ábrelo." },
      { name: "Abrir Settings del servidor", text: "Pulsa el icono del engranaje arriba (o clic derecho en el servidor → Settings)." },
      { name: "Ajustar el slider Maximum RAM", text: "Ajusta Maximum RAM en pasos de 256 MiB. El máximo de la interfaz es el menor entre la RAM del sistema redondeada hacia abajo en MiB y 32768 MiB (32 GiB). Por encima del 80% aparece un aviso; el 80% no es un límite." },
      { name: "Guardar", text: "Confirma. El valor nuevo se escribe en los argumentos de arranque del servidor." },
      { name: "Reiniciar el servidor", text: "Si está corriendo, detenlo y arráncalo de nuevo. Los cambios de RAM se aplican al siguiente arranque." }
    ]
  },
  "pt-BR": {
    title: "Como alocar mais RAM a um servidor de Minecraft",
    description: "Aumente a memória disponível para um servidor de Minecraft no GDLauncher para aguentar mais jogadores, mods e carga de chunks.",
    steps: [
      { name: "Abrir o servidor na Library", text: "No GDLauncher, vá em Servers (ou Library), selecione o servidor e abra-o." },
      { name: "Abrir Settings do servidor", text: "Clique no ícone de engrenagem no topo (ou clique com o botão direito no servidor → Settings)." },
      { name: "Ajustar o slider Maximum RAM", text: "Ajuste Maximum RAM em passos de 256 MiB. O máximo da interface é o menor entre a RAM do sistema arredondada para baixo em MiB e 32768 MiB (32 GiB). Acima de 80% aparece um aviso; 80% não é um limite." },
      { name: "Salvar", text: "Confirme. O novo valor é gravado nos argumentos de inicialização do servidor." },
      { name: "Reiniciar o servidor", text: "Se estiver rodando, pare e inicie de novo. Mudanças de RAM só valem no próximo arranque." }
    ]
  },
  it: {
    title: "Come allocare più RAM a un server Minecraft",
    description: "Aumenta la memoria disponibile per un server Minecraft in GDLauncher per sostenere più giocatori, mod e carico di chunk.",
    steps: [
      { name: "Apri il server nella Library", text: "In GDLauncher, vai su Servers (o Library), seleziona il server e aprilo." },
      { name: "Apri Settings del server", text: "Clicca l'icona dell'ingranaggio in alto (oppure clic destro sul server, Settings)." },
      { name: "Regola lo slider Maximum RAM", text: "Regola Maximum RAM in passi di 256 MiB. Il massimo dell’interfaccia è il minore tra la RAM di sistema arrotondata per difetto in MiB e 32768 MiB (32 GiB). Oltre l’80% compare un avviso; l’80% non è un limite." },
      { name: "Salva", text: "Conferma. Il nuovo valore viene scritto negli argomenti di avvio del server." },
      { name: "Riavvia il server", text: "Se è in esecuzione, fermalo e riavvialo. Le modifiche di RAM hanno effetto dal prossimo avvio." }
    ]
  }
}
const m = meta[locale]
---

<GuideLayout title={m.title} description={m.description} lastUpdated="May 2026" howTo={{ totalTimeIso: "PT2M", steps: m.steps }}>
  {locale === "ja" && (
    <Fragment>
      <h2>サーバーに必要な RAM の目安</h2>
      <p>バニラで 1〜4 人なら 2GB、5〜20 人なら 4GB が目安。Mod 入りはぐっと増え、軽め (50 Mod) なら 4〜6GB、中規模 (100 Mod) で 6〜8GB、All The Mods や GregTech のような重量級は 8〜12GB 以上必要です。</p>

      <h2>システム RAM を全部割り当てない</h2>
      <p>Maximum RAM を 256 MiB 刻みで調整します。UI の上限は、システム RAM を MiB 単位で切り捨てた値と 32768 MiB (32 GiB) の小さい方です。80% を超えると警告が出ますが、80% で制限されるわけではありません。 OS、他のアプリ、同じマシンの Minecraft クライアントにもメモリを残してください。割り当てすぎるとスワップや停止が起きることがあります。</p>

      <h2>サーバーとインスタンスのメモリは別</h2>
      <p>サーバーの RAM 設定はクライアント (インスタンス) と独立しています。同じマシンで両方走らせる場合は合計が OS の取り分を残せるか確認しましょう。プレイヤー側のメモリ調整は <a href={localizedPath("/guides/allocate-more-ram", locale)}>インスタンスの RAM ガイド</a> を参照。</p>
    </Fragment>
  )}

  {locale === "ko" && (
    <Fragment>
      <h2>서버에 필요한 RAM 가이드</h2>
      <p>바닐라에 1~4인이면 2GB, 5~20인이면 4GB 정도가 무난합니다. 모드를 넣으면 늘어나서 가벼운 팩(50 모드)은 4~6GB, 중간(100 모드)은 6~8GB, All The Mods나 GregTech 같은 대형은 8~12GB 이상 필요합니다.</p>

      <h2>시스템 RAM 전부를 주지 마세요</h2>
      <p>Maximum RAM을 256 MiB 단위로 조정하세요. UI 상한은 시스템 RAM을 MiB로 내림한 값과 32768 MiB(32 GiB) 중 작은 값입니다. 80%를 초과하면 경고가 표시되지만 80%에서 제한되지는 않습니다. 운영체제, 다른 앱, 같은 머신의 Minecraft 클라이언트를 위한 메모리를 남겨 두세요. 너무 많이 할당하면 스왑이나 멈춤이 발생할 수 있습니다.</p>

      <h2>서버와 인스턴스 메모리는 별개</h2>
      <p>서버의 RAM 설정은 클라이언트(인스턴스)와 독립입니다. 같은 머신에서 둘 다 실행한다면 합계가 OS 몫을 남기도록 확인하세요. 플레이어 쪽 메모리는 <a href={localizedPath("/guides/allocate-more-ram", locale)}>인스턴스 RAM 가이드</a>를 참고.</p>
    </Fragment>
  )}

  {locale === "de" && (
    <Fragment>
      <h2>Wie viel RAM braucht ein Server</h2>
      <p>Vanilla mit 1–4 Spielern: 2 GB. 5–20 Spieler: 4 GB. Modded steigt deutlich: leichter Pack (50 Mods) 4–6 GB, mittlerer (100 Mods) 6–8 GB, große wie All The Mods oder GregTech 8–12 GB und mehr.</p>

      <h2>Nicht den ganzen System-RAM zuweisen</h2>
      <p>Stelle Maximum RAM in Schritten von 256 MiB ein. Das UI-Maximum ist der kleinere Wert aus dem auf ganze MiB abgerundeten System-RAM und 32768 MiB (32 GiB). Über 80% erscheint eine Warnung; 80% ist keine Begrenzung. Lass Speicher für das Betriebssystem, andere Programme und einen Minecraft-Client auf demselben Rechner frei. Zu viel Zuweisung kann zu Swapping und Stocken führen.</p>

      <h2>Server- vs Instanz-Speicher</h2>
      <p>Die RAM-Einstellung des Servers ist unabhängig von einer Client-Instanz für dasselbe Modpack. Wenn du beides auf demselben Rechner laufen lässt, achte darauf, dass die Summe noch Luft fürs OS lässt. Für die Spieler-Seite siehe den <a href={localizedPath("/guides/allocate-more-ram", locale)}>RAM-Guide für Instanzen</a>.</p>
    </Fragment>
  )}

  {locale === "fr" && (
    <Fragment>
      <h2>Combien de RAM pour le serveur</h2>
      <p>Vanilla, 1–4 joueurs : 2 Go. 5–20 joueurs : 4 Go. Avec mods ça grimpe : pack léger (50 mods) 4–6 Go, moyen (100 mods) 6–8 Go, gros comme All The Mods ou GregTech 8–12 Go et plus.</p>

      <h2>Ne donne pas toute ta RAM</h2>
      <p>Règle Maximum RAM par pas de 256 MiB. Le maximum de l’interface est le plus petit entre la RAM système arrondie vers le bas en MiB et 32768 MiB (32 GiB). Au-delà de 80%, un avertissement apparaît ; 80% n’est pas une limite. Garde de la mémoire pour le système, les autres apps et le client Minecraft sur la même machine. Une allocation trop élevée peut provoquer du swap et des blocages.</p>

      <h2>Mémoire serveur vs instance</h2>
      <p>Le réglage RAM du serveur est indépendant d'une instance client pour le même modpack. Si tu fais tourner les deux sur la même machine, vérifie que le total laisse de la marge à l'OS. Pour le côté joueur, voir le <a href={localizedPath("/guides/allocate-more-ram", locale)}>guide RAM pour instance</a>.</p>
    </Fragment>
  )}

  {locale === "es" && (
    <Fragment>
      <h2>Cuánta RAM necesita el servidor</h2>
      <p>Vanilla con 1–4 jugadores: 2 GB. 5–20 jugadores: 4 GB. Modeado sube mucho: pack ligero (50 mods) 4–6 GB, medio (100 mods) 6–8 GB, grandes como All The Mods o GregTech 8–12 GB o más.</p>

      <h2>No asignes toda la RAM del sistema</h2>
      <p>Ajusta Maximum RAM en pasos de 256 MiB. El máximo de la interfaz es el menor entre la RAM del sistema redondeada hacia abajo en MiB y 32768 MiB (32 GiB). Por encima del 80% aparece un aviso; el 80% no es un límite. Deja memoria para el sistema operativo, otras apps y el cliente de Minecraft en la misma máquina. Asignar demasiado puede causar intercambio de memoria y bloqueos.</p>

      <h2>Memoria del servidor vs de la instancia</h2>
      <p>El ajuste de RAM del servidor es independiente de una instancia cliente del mismo modpack. Si vas a correr ambos en la misma máquina, asegúrate de que la suma deje aire al SO. Para el lado del jugador, mira la <a href={localizedPath("/guides/allocate-more-ram", locale)}>guía de RAM para instancias</a>.</p>
    </Fragment>
  )}

  {locale === "pt-BR" && (
    <Fragment>
      <h2>Quanta RAM o servidor precisa</h2>
      <p>Vanilla com 1–4 jogadores: 2 GB. 5–20 jogadores: 4 GB. Modado sobe bastante: pack leve (50 mods) 4–6 GB, médio (100 mods) 6–8 GB, grandes como All The Mods ou GregTech 8–12 GB ou mais.</p>

      <h2>Não aloque toda a RAM do sistema</h2>
      <p>Ajuste Maximum RAM em passos de 256 MiB. O máximo da interface é o menor entre a RAM do sistema arredondada para baixo em MiB e 32768 MiB (32 GiB). Acima de 80% aparece um aviso; 80% não é um limite. Deixe memória para o sistema operacional, outros apps e o cliente Minecraft na mesma máquina. Alocar demais pode causar swap e travamentos.</p>

      <h2>Memória do servidor vs da instância</h2>
      <p>A RAM do servidor é independente de uma instância cliente do mesmo modpack. Se for rodar os dois na mesma máquina, garanta que a soma deixe folga para o SO. Para o lado do jogador, veja o <a href={localizedPath("/guides/allocate-more-ram", locale)}>guia de RAM para instâncias</a>.</p>
    </Fragment>
  )}

  {locale === "it" && (
    <Fragment>
      <h2>Quanta RAM serve al server</h2>
      <p>Vanilla con 1-4 giocatori: 2 GB. 5-20 giocatori: 4 GB. Con le mod sale parecchio: pack leggero (50 mod) 4-6 GB, medio (100 mod) 6-8 GB, grandi come All The Mods o GregTech 8-12 GB o più.</p>

      <h2>Non assegnare tutta la RAM di sistema</h2>
      <p>Regola Maximum RAM in passi di 256 MiB. Il massimo dell’interfaccia è il minore tra la RAM di sistema arrotondata per difetto in MiB e 32768 MiB (32 GiB). Oltre l’80% compare un avviso; l’80% non è un limite. Lascia memoria per il sistema operativo, le altre app e il client Minecraft sulla stessa macchina. Assegnarne troppa può causare swap e blocchi.</p>

      <h2>Memoria del server vs dell'istanza</h2>
      <p>L'impostazione RAM del server è indipendente da un'istanza client per lo stesso Modpack. Se li fai girare entrambi sulla stessa macchina, assicurati che la somma lasci aria al sistema operativo. Per il lato giocatore, vedi la <a href={localizedPath("/guides/allocate-more-ram", locale)}>guida RAM per le istanze</a>.</p>
    </Fragment>
  )}
</GuideLayout>
