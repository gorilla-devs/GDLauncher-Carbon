      { name: "Esperar a que termine la instalación", text: "GDLauncher descarga Minecraft, la versión de Java correcta y el loader NeoForge automáticamente. Sin instaladores manuales." },
      { name: "Añadir mods de NeoForge", text: "Abre la nueva instancia, ve a la pestaña Addons e instala mods compatibles con NeoForge desde CurseForge o Modrinth con un clic. Las dependencias se traen solas." },
      { name: "Pulsar Play", text: "Haz clic en Play. Tu instancia NeoForge arranca con todo ya conectado." }
    ]
  },
  "pt-BR": {
    title: "Como instalar o Minecraft NeoForge",
    description: "Guia passo a passo para instalar o NeoForge com o GDLauncher. O fork moderno do Forge para onde a maioria dos grandes mods de conteúdo está mirando.",
    steps: [
      { name: "Baixar o GDLauncher", text: "Baixe e instale o GDLauncher em gdlauncher.com. Grátis, disponível para Windows, macOS e Linux." },
      { name: "Criar uma nova instância", text: "Abra o GDLauncher e clique no botão + da página Library para começar uma nova instância do Minecraft." },
      { name: "Escolher NeoForge como loader", text: "Selecione NeoForge no menu de loader e escolha a versão do Minecraft (1.20.1 foi o primeiro lançamento NeoForge; o 1.21.x é onde acontece o modding novo)." },
      { name: "Aguardar a instalação", text: "O GDLauncher baixa o Minecraft, a versão de Java certa e o loader NeoForge automaticamente. Sem instalador manual." },
      { name: "Adicionar mods NeoForge", text: "Abra a nova instância, vá na aba Addons e instale mods compatíveis com NeoForge do CurseForge ou Modrinth com um clique. Dependências entram juntas automaticamente." },
      { name: "Apertar Play", text: "Clique em Play. Sua instância NeoForge inicia já configurada." }
    ]
  },
  it: {
    title: "Come installare Minecraft NeoForge",
    description: "Guida passo passo per installare NeoForge con GDLauncher. Il fork moderno di Forge su cui ormai punta la maggior parte delle grandi Mod di contenuto.",
    steps: [
      { name: "Scaricare GDLauncher", text: "Scarica e installa GDLauncher da gdlauncher.com. Gratuito, disponibile per Windows, macOS e Linux." },
      { name: "Creare una nuova istanza", text: "Apri GDLauncher e clicca sul pulsante + nella pagina Library per creare una nuova istanza Minecraft." },
      { name: "Scegliere NeoForge come loader", text: "Seleziona NeoForge nel menu del loader e scegli la versione di Minecraft (1.20.1 è stata la prima release NeoForge; il 1.21.x è dove si concentra il nuovo modding)." },
      { name: "Attendere il termine dell'installazione", text: "GDLauncher scarica Minecraft, la versione corretta di Java e il loader NeoForge in automatico. Niente installer manuali." },
      { name: "Aggiungere Mod NeoForge", text: "Apri la nuova istanza, vai nella scheda Addons e installa le Mod compatibili con NeoForge da CurseForge o Modrinth con un clic. Le dipendenze vengono incluse in automatico." },
      { name: "Premere Play", text: "Clicca su Play. La tua istanza NeoForge si avvia già pronta." }
