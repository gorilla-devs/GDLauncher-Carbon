---
/**
 * Localized "How to Install Minecraft Quilt" guide.
 *
 * One file, seven locales. The locale comes from the route param; we look up
 * translated metadata + steps and render the matching body block. Brand
 * names (Quilt, Fabric, Forge, NeoForge, GDLauncher, CurseForge, Modrinth,
 * Quilted Fabric API, QFAPI, Sodium, Iris, Continuity, LambDynamicLights)
 * stay untranslated.
 */
import GuideLayout from "../../../components/GuideLayout.astro"
import type { GetStaticPaths } from "astro"
import { LOCALES, DEFAULT_LOCALE, type Locale } from "../../../lib/i18n"

export const getStaticPaths: GetStaticPaths = () =>
  LOCALES
    .filter((loc) => loc !== DEFAULT_LOCALE)
    .map((loc) => ({ params: { locale: loc } }))

const { locale } = Astro.params as { locale: Exclude<Locale, "en"> }

interface Step { name: string; text: string }
interface Meta { title: string; description: string; steps: Step[] }

const meta: Record<Exclude<Locale, "en">, Meta> = {
