      { name: "Apertar Play", text: "Clique em Play. Sua instância Quilt inicia com todos os mods instalados carregados." }
    ]
  },
  it: {
    title: "Come installare Minecraft Quilt",
    description: "Guida passo passo per installare il Mod loader Quilt con GDLauncher. Esegue la maggior parte delle Mod Fabric più i propri.",
    steps: [
      { name: "Scaricare GDLauncher", text: "Scarica e installa GDLauncher da gdlauncher.com. Gratuito, disponibile per Windows, macOS e Linux." },
      { name: "Creare una nuova istanza", text: "Apri GDLauncher e clicca sul pulsante + nella pagina Library per creare una nuova istanza Minecraft." },
      { name: "Scegliere Quilt come loader", text: "Seleziona Quilt nel menu del loader e scegli la versione di Minecraft. Quilt copre più o meno la stessa fascia moderna di Fabric." },
      { name: "Attendere il termine dell'installazione", text: "GDLauncher scarica Minecraft, la versione corretta di Java e il loader Quilt in automatico. Niente installer manuali." },
      { name: "Aggiungere Mod", text: "Apri la nuova istanza, vai nella scheda Addons e installa con un clic qualsiasi Mod Fabric o Quilt. La Quilted Fabric API viene tirata dentro come dipendenza in automatico." },
      { name: "Premere Play", text: "Clicca su Play. La tua istanza Quilt parte con tutte le Mod installate caricate." }
