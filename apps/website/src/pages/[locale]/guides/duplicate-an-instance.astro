---
import GuideLayout from "../../../components/GuideLayout.astro"
import type { GetStaticPaths } from "astro"
import { LOCALES, DEFAULT_LOCALE, type Locale,
  localizeInternalLinks,
} from "../../../lib/i18n"

export const getStaticPaths: GetStaticPaths = () =>
  LOCALES
    .filter((loc) => loc !== DEFAULT_LOCALE)
    .map((loc) => ({ params: { locale: loc } }))

const { locale } = Astro.params as { locale: Exclude<Locale, "en"> }

interface Step { name: string; text: string }
interface Meta { title: string; description: string; steps: Step[] }

const meta: Record<Exclude<Locale, "en">, Meta> = {
  ja: {
    title: "GDLauncher でインスタンスを複製する方法",
    description: "既存のインスタンスを丸ごとコピー。Mod 変更を安全にテストしたり、プレイスルーを分岐したりするのに便利。",
    steps: [
      { name: "インスタンスを右クリック", text: "Library で複製したいインスタンスを右クリック。" },
      { name: "More Options を開く", text: "More Options にホバーしてサブメニューを表示。" },
      { name: "Duplicate をクリック", text: "Duplicate (コピーアイコン) を選択。GDLauncher がインスタンスフォルダーを新しい名前でコピーし、別インスタンスとして登録。" },
      { name: "コピー完了を待つ", text: "小さなインスタンスなら数秒、数百 Mod の大型 Modpack は 1~2 分。その間ランチャーはファイルシステムコピーでブロックします。完了すると新しいインスタンスが元の隣に表示。" },
      { name: "好みでリネーム", text: "複製は元の名前にサフィックスが付きます。右クリック → Edit でわかりやすい名前に変更。" }
    ]
  },
  ko: {
    title: "GDLauncher에서 인스턴스 복제하는 법",
    description: "기존 인스턴스의 전체 복사본을 만들기. 모드 변경을 안전하게 테스트하거나 플레이를 분기할 때 유용.",
    steps: [
      { name: "인스턴스 오른쪽 클릭", text: "Library에서 복제할 인스턴스를 오른쪽 클릭." },
      { name: "More Options 열기", text: "More Options 위에 마우스를 올려 서브메뉴 표시." },
      { name: "Duplicate 클릭", text: "Duplicate(복사 아이콘) 선택. GDLauncher가 인스턴스 폴더를 새 이름으로 복사하고 별도 인스턴스로 등록." },
      { name: "복사 완료 대기", text: "작은 인스턴스는 몇 초, 수백 모드 대형 모드팩은 1~2분. 그 동안 런처는 파일시스템 복사로 블록됩니다. 끝나면 새 인스턴스가 원본 옆에 나타납니다." },
      { name: "원하면 이름 변경", text: "복제본은 원본 이름에 접미사가 붙음. 오른쪽 클릭 → Edit으로 의미 있는 이름으로 변경." }
    ]
  },
  de: {
    title: "Eine Instanz in GDLauncher duplizieren",
    description: "Eine vollständige Kopie einer Instanz erstellen, praktisch zum sicheren Testen von Mod-Änderungen oder zum Verzweigen eines Spielstands.",
    steps: [
      { name: "Rechtsklick auf die Instanz", text: "In der Library Rechtsklick auf die zu duplizierende Instanz." },
      { name: "More Options öffnen", text: "Über More Options hovern, um das Untermenü zu öffnen." },
      { name: "Duplicate klicken", text: "Duplicate wählen (Copy-Icon). GDLauncher kopiert den Instanz-Ordner unter einem neuen Namen und registriert ihn als eigene Instanz." },
      { name: "Auf die Kopie warten", text: "Bei kleinen Instanzen Sekunden, große Modpacks mit hunderten Mods brauchen ein bis zwei Minuten; währenddessen blockiert der Launcher auf der Filesystem-Kopie. Fertig: die neue Instanz erscheint neben dem Original." },
      { name: "Bei Bedarf umbenennen", text: "Das Duplikat bekommt den Originalnamen plus Suffix. Rechtsklick → Edit zum Umbenennen." }
    ]
  },
  fr: {
    title: "Comment dupliquer une instance dans GDLauncher",
    description: "Fais une copie complète d'une instance existante, utile pour tester des changements de mods en sécurité ou pour brancher une partie.",
    steps: [
      { name: "Clic droit sur l'instance", text: "Dans la Library, clic droit sur l'instance à dupliquer." },
      { name: "Ouvrir More Options", text: "Survole More Options pour faire apparaître le sous-menu." },
      { name: "Cliquer Duplicate", text: "Choisis Duplicate (icône copie). GDLauncher copie le dossier de l'instance sous un nouveau nom et l'enregistre comme une instance séparée." },
      { name: "Attendre la copie", text: "Pour les petites instances, copie en quelques secondes. Les gros modpacks avec des centaines de mods prennent une minute ou deux ; pendant ce temps le launcher est bloqué sur une copie filesystem. À la fin, la nouvelle instance apparaît à côté de l'originale." },
      { name: "Renommer si tu veux", text: "Le duplicat reçoit le nom original plus un suffixe. Clic droit → Edit pour le renommer en quelque chose de plus parlant." }
    ]
  },
  es: {
    title: "Cómo duplicar una instancia en GDLauncher",
    description: "Haz una copia completa de una instancia existente, útil para probar cambios de mods con seguridad o para bifurcar una partida.",
    steps: [
      { name: "Clic derecho en la instancia", text: "En la Library, clic derecho en la instancia a duplicar." },
      { name: "Abrir More Options", text: "Pasa el ratón por More Options para revelar el submenú." },
      { name: "Pulsar Duplicate", text: "Elige Duplicate (icono de copia). GDLauncher copia la carpeta de la instancia con un nombre nuevo y la registra como instancia aparte." },
      { name: "Esperar la copia", text: "Instancias pequeñas se copian en segundos. Modpacks grandes con cientos de mods tardan uno o dos minutos; durante ese tiempo el launcher está bloqueado en una copia de filesystem. Al terminar, la nueva instancia aparece junto a la original." },
      { name: "Renombrar si quieres", text: "El duplicado recibe el nombre original más un sufijo. Clic derecho → Edit para renombrarlo a algo significativo." }
    ]
  },
  "pt-BR": {
    title: "Como duplicar uma instância no GDLauncher",
    description: "Faça uma cópia completa de uma instância existente, útil pra testar mudanças de mod com segurança ou bifurcar uma campanha.",
    steps: [
      { name: "Botão direito na instância", text: "Na Library, botão direito na instância que vai duplicar." },
      { name: "Abra More Options", text: "Passe o mouse por More Options pra revelar o submenu." },
      { name: "Clique Duplicate", text: "Escolha Duplicate (ícone de cópia). O GDLauncher copia a pasta da instância com um novo nome e registra como instância separada." },
      { name: "Espere a cópia", text: "Instâncias pequenas copiam em segundos. Modpacks grandes com centenas de mods levam um ou dois minutos; durante esse tempo o launcher bloqueia numa cópia do filesystem. Quando terminar, a nova instância aparece ao lado da original." },
      { name: "Renomeie se quiser", text: "O duplicado pega o nome original mais um sufixo. Botão direito → Edit pra renomear pra algo significativo." }
    ]
  },
  it: {
    title: "Come duplicare un'istanza in GDLauncher",
    description: "Fai una copia completa di un'istanza esistente, utile per testare modifiche alle mod in sicurezza o per ramificare una partita.",
    steps: [
      { name: "Clic destro sull'istanza", text: "Nella Library, fai clic destro sull'istanza da duplicare." },
      { name: "Apri More Options", text: "Passa il mouse su More Options per rivelare il sottomenu." },
      { name: "Clicca Duplicate", text: "Scegli Duplicate (icona di copia). GDLauncher copia la cartella dell'istanza con un nuovo nome e la registra come istanza separata." },
      { name: "Attendi la copia", text: "Le istanze piccole si copiano in pochi secondi. I modpack grandi con centinaia di mod richiedono uno o due minuti, durante i quali il launcher si blocca sulla copia del filesystem. Quando finisce, la nuova istanza appare accanto all'originale." },
      { name: "Rinomina se vuoi", text: "Il duplicato eredita il nome originale con un suffisso. Clic destro → Edit per rinominarlo con qualcosa di più chiaro." }
    ]
  }
}
const m = meta[locale]

const body: Record<Exclude<Locale, "en">, { headings: string[]; paras: string[] }> = {
  ja: {
    headings: ["コピーされるもの", "Duplicate を使う場面", "コピーされないもの", "Locked / Unlocked、Paired / Unpaired", "ディスク容量の注意"],
    paras: [
      "インスタンスフォルダー全体: Mod、設定、ワールド、スクリーンショット、options.txt、リソースパック、シェーダーパック、インスタンス別 GDLauncher メタデータを含む。複製は元から独立、片方の変更がもう片方に影響しません。",
      "<strong>Mod 変更の安全テスト</strong>: 新しい Mod を試したいけど壊れるか不安? 先に複製、コピーで試し、安定を確認してから元を更新。<strong>プレイスルー分岐</strong>: ワールドの分岐点で両方向を試したい? 複製して各分岐を別々に遊ぶ。<strong>同じベースで別 Mod ローダーを試す</strong>: 複製、複製側のローダーを切替 (<a href=\"/guides/switch-mod-loader\">Mod ローダー切替方法</a>参照)。<strong>リスキーな変更前の安価なバックアップ</strong>: プレイ中の Modpack バージョン更新が一例、先に複製、コピーで更新実行。",
      "インスタンスフォルダー外のものは複製されません。アカウントとランチャーレベルの設定は同じまま (どっちみちインスタンス別ではない)。一部 Modpack は App Data Path や別の場所にコンテンツを持ち、それらも複製されませんが、実用上問題になることは稀。",
      "複製はロック状態と Modpack ペアリングを保持。ロックされた Modpack インスタンスはロックされた Modpack 複製を作り、同じ Modpack を指したまま。両方ともインスタンスの Settings タブの Change Modpack Version で独立に更新可能。複製にソースパックを追跡させたくないなら、複製後に Settings タブを開いて Modpack Info セクションの <strong>Unpair</strong> をクリック。",
      "複製はファイルシステム完全コピー、シンボリックリンクや copy-on-write ではありません。各複製は元のディスク使用量を倍にします。50 GB の Modpack ならすぐ膨らみます、長期保持の必要を検討してください。"
    ]
  },
  ko: {
