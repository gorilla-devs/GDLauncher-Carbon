      { name: "Fabric-Mods hinzufügen", text: "Öffne deine neue Instanz, geh in den Addons-Tab und installiere mit dem eingebauten Browser jeden Fabric-kompatiblen Mod aus CurseForge oder Modrinth per Klick." },
      { name: "Auf Play drücken", text: "Klick auf Play. Deine modifizierte Fabric-Instanz ist startklar." }
    ]
  },
  fr: {
    title: "Comment installer Minecraft Fabric",
    description: "Apprends à installer le mod loader Fabric pour Minecraft avec GDLauncher. Guide rapide et simple.",
    steps: [
      { name: "Télécharger GDLauncher", text: "Télécharge et installe GDLauncher depuis gdlauncher.com. C'est gratuit et ça marche sur Windows, macOS et Linux." },
      { name: "Créer une nouvelle instance", text: "Ouvre GDLauncher et clique sur le bouton + de la page Library pour créer une nouvelle instance Minecraft." },
      { name: "Choisir Fabric comme loader", text: "Au moment de choisir le mod loader, sélectionne Fabric. GDLauncher liste toutes les versions de Minecraft que Fabric supporte, choisis celle que tu veux jouer." },
      { name: "Attendre la fin de l'installation", text: "GDLauncher télécharge Minecraft, la bonne version de Java et le loader Fabric automatiquement. Pas de config manuelle." },
      { name: "Ajouter des mods Fabric", text: "Ouvre ton instance, va dans l'onglet Addons et utilise le navigateur intégré pour installer en un clic n'importe quel mod compatible Fabric depuis CurseForge ou Modrinth." },
      { name: "Appuyer sur Play", text: "Clique sur Play. Ton instance Fabric moddée est prête." }
    ]
  },
  es: {
    title: "Cómo instalar Minecraft Fabric",
    description: "Aprende a instalar el mod loader Fabric en Minecraft con GDLauncher. Guía rápida y sencilla.",
    steps: [
      { name: "Descargar GDLauncher", text: "Descarga e instala GDLauncher desde gdlauncher.com. Es gratis y funciona en Windows, macOS y Linux." },
      { name: "Crear una nueva instancia", text: "Abre GDLauncher y haz clic en el botón + de la página Library para crear una nueva instancia de Minecraft." },
      { name: "Elegir Fabric como loader", text: "Al escoger el mod loader, selecciona Fabric. GDLauncher mostrará todas las versiones de Minecraft que Fabric soporta, elige la que quieras jugar." },
      { name: "Esperar a que termine la instalación", text: "GDLauncher descarga Minecraft, la versión de Java correcta y el loader Fabric automáticamente. Sin configuración manual." },
      { name: "Añadir mods de Fabric", text: "Abre tu nueva instancia, ve a la pestaña Addons y usa el navegador integrado para instalar con un clic cualquier mod compatible con Fabric desde CurseForge o Modrinth." },
      { name: "Pulsar Play", text: "Haz clic en Play. Tu instancia Fabric con mods está lista." }
    ]
  },
  "pt-BR": {
    title: "Como instalar o Minecraft Fabric",
    description: "Aprenda a instalar o mod loader Fabric para o Minecraft usando o GDLauncher. Guia de configuração rápido e fácil.",
    steps: [
      { name: "Baixar o GDLauncher", text: "Baixe e instale o GDLauncher em gdlauncher.com, é grátis e funciona no Windows, macOS e Linux." },
      { name: "Criar uma nova instância", text: "Abra o GDLauncher e clique no botão + da página Library para criar uma nova instância do Minecraft." },
      { name: "Escolher Fabric como loader", text: "Ao escolher o mod loader, selecione Fabric. O GDLauncher lista todas as versões de Minecraft que o Fabric suporta, escolha a que você quer jogar." },
      { name: "Aguardar a instalação", text: "O GDLauncher baixa Minecraft, a versão correta do Java e o loader Fabric automaticamente. Sem configuração manual." },
      { name: "Adicionar mods Fabric", text: "Abra a nova instância, vá na aba Addons e use o navegador embutido para instalar qualquer mod compatível com Fabric do CurseForge ou Modrinth com um clique." },
      { name: "Apertar Play", text: "Clique em Play. Sua instância Fabric com mods está pronta." }
    ]
  },
  it: {
    title: "Come installare Minecraft Fabric",
    description: "Scopri come installare il Mod loader Fabric per Minecraft usando GDLauncher. Guida rapida e semplice alla configurazione.",
    steps: [
      { name: "Scaricare GDLauncher", text: "Scarica e installa GDLauncher da gdlauncher.com, è gratuito e funziona su Windows, macOS e Linux." },
      { name: "Creare una nuova istanza", text: "Apri GDLauncher e clicca sul pulsante + nella pagina Library per creare una nuova istanza Minecraft." },
      { name: "Scegliere Fabric come loader", text: "Quando devi scegliere il Mod loader, seleziona Fabric. GDLauncher elenca tutte le versioni di Minecraft supportate da Fabric, scegli quella a cui vuoi giocare." },
      { name: "Attendere il termine dell'installazione", text: "GDLauncher scarica Minecraft, la versione corretta di Java e il loader Fabric in automatico. Niente configurazione manuale." },
      { name: "Aggiungere Mod Fabric", text: "Apri la nuova istanza, vai nella scheda Addons e usa il browser integrato per installare con un clic qualsiasi Mod compatibile con Fabric da CurseForge o Modrinth." },
      { name: "Premere Play", text: "Clicca su Play. La tua istanza Fabric con Mod è pronta." }
