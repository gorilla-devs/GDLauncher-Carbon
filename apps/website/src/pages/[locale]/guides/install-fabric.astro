---
/**
 * Localized "How to Install Minecraft Fabric" guide.
 *
 * One file, six locales. The locale comes from the route param; we look up
 * translated metadata + steps and render the matching body block. Brand
 * names (Fabric, Forge, NeoForge, Quilt, GDLauncher, CurseForge, Modrinth,
 * Sodium, Lithium, FerriteCore, Mod Menu, OptiFine, Iris, Continuity,
 * LambDynamicLights, Sodium Extra) stay untranslated.
 */
import GuideLayout from "../../../components/GuideLayout.astro"
import type { GetStaticPaths } from "astro"
import { LOCALES, DEFAULT_LOCALE, type Locale } from "../../../lib/i18n"

export const getStaticPaths: GetStaticPaths = () =>
  LOCALES
    .filter((loc) => loc !== DEFAULT_LOCALE)
    .map((loc) => ({ params: { locale: loc } }))

const { locale } = Astro.params as { locale: Exclude<Locale, "en"> }

interface Step { name: string; text: string }
interface Meta { title: string; description: string; steps: Step[] }

const meta: Record<Exclude<Locale, "en">, Meta> = {
  ja: {
    title: "Minecraft Fabric の導入方法",
    description: "GDLauncher で Fabric Mod ローダーを Minecraft に導入する方法を解説。簡単・素早いセットアップガイド。",
    steps: [
      { name: "GDLauncher をダウンロード", text: "gdlauncher.com から GDLauncher をダウンロードしてインストール。無料で、Windows / macOS / Linux に対応しています。" },
      { name: "新しいインスタンスを作成", text: "GDLauncher を開き、Library ページの + ボタンから新しい Minecraft インスタンスを作成します。" },
      { name: "ローダーで Fabric を選択", text: "Mod ローダーの選択で Fabric を選びます。Fabric が対応する Minecraft バージョンが一覧表示されるので、遊びたいバージョンを選択。" },
      { name: "インストールが終わるまで待つ", text: "GDLauncher が Minecraft、対応する Java、Fabric ローダーをすべて自動でダウンロードします。手動設定は不要です。" },
      { name: "Fabric Mod を追加", text: "新しいインスタンスを開き、Addons タブから組み込みブラウザを使って、CurseForge や Modrinth の Fabric 対応 Mod をワンクリックで導入できます。" },
      { name: "Play を押す", text: "Play をクリック。Mod 入りの Fabric インスタンスが起動します。" }
    ]
  },
