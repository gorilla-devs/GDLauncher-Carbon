 * Create, Twilight Forest). UI labels stay in English (Addons, Download,
 * Play, Quick Install ID).
 */
import KeywordLandingLayout from "../../components/KeywordLandingLayout.astro"
import type { GetStaticPaths } from "astro"
import { LOCALES, DEFAULT_LOCALE, type Locale,
  localizedPath,
} from "../../lib/i18n"

export const getStaticPaths: GetStaticPaths = () =>
  LOCALES
    .filter((loc) => loc !== DEFAULT_LOCALE)
    .map((loc) => ({ params: { locale: loc } }))

const { locale } = Astro.params as { locale: Exclude<Locale, "en"> }

interface FaqEntry { question: string; answer: string }
interface Meta {
  title: string
