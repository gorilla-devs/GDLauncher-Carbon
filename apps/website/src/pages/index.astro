---
import BaseHead from "../components/BaseHead.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import LoadingBar from "../components/LoadingBar.astro"
import HeroSection from "../components/landing/HeroSection.astro"
import TrustBar from "../components/landing/TrustBar.astro"
import FeaturesShowcase from "../components/landing/FeaturesShowcase.astro"
import ComparisonTable from "../components/landing/ComparisonTable.astro"
import Testimonials from "../components/landing/Testimonials.astro"
import CTABanner from "../components/landing/CTABanner.astro"
import ParticleBackground from "../components/ParticleBackground.astro"
import "@fontsource/ubuntu"
import "@fontsource/ubuntu/500.css"
import "@fontsource/ubuntu/700.css"
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts"

// Cache the page for 60 seconds
Astro.locals.cache(60)
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      keywords="minecraft launcher, modpack launcher, curseforge launcher, modrinth launcher, minecraft mods, minecraft modpacks, gdlauncher, minecraft mod manager, forge launcher, fabric launcher"
    />
  </head>

  <body class="text-lightSlate-50 overflow-x-hidden">
    <LoadingBar />
    <!-- Background layers -->
    <div class="fixed inset-0 -z-10 bg-darkSlate-800">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_0%,rgba(43,107,177,0.12),transparent)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
    </div>
    <ParticleBackground />
    <Header />

    <main>
      <!-- Hero: Split layout with text left, app preview right -->
      <HeroSection />

      <!-- Trust Bar: Platform logos and modloader support -->
      <TrustBar />

      <!-- Features Showcase: Key features with video placeholders -->
      <FeaturesShowcase />

      <!-- Comparison Table: GDLauncher vs other launchers -->
      <ComparisonTable />

      <!-- Testimonials: Community feedback -->
      <Testimonials />

      <!-- CTA Banner: Final download push + newsletter -->
      <CTABanner />
    </main>

    <Footer />

    <!-- Scroll Animations -->
    <script>
      import "../scripts/scroll-animations"
    </script>
  </body>
</html>
