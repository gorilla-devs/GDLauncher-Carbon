---
/**
 * Guides Hub Page
 */
import BaseHead from "../../components/BaseHead.astro"
import Header from "../../components/Header.astro"
import Footer from "../../components/Footer.astro"
import LoadingBar from "../../components/LoadingBar.astro"
import Breadcrumb from "../../components/Breadcrumb.astro"
import "@fontsource/ubuntu"
import "@fontsource/ubuntu/500.css"
import "@fontsource/ubuntu/700.css"

const guides = [
  {
    title: "How to Install Modpacks",
    description: "Learn how to install Minecraft modpacks with GDLauncher in just a few clicks.",
    href: "/guides/install-modpack",
    category: "Installation Guides"
  },
  {
    title: "How to Install Mods",
    description: "Learn how to find and install individual Minecraft mods from CurseForge and Modrinth.",
    href: "/guides/install-mods",
    category: "Installation Guides"
  },
  {
    title: "How to Install Shaders",
    description: "Transform your Minecraft graphics with beautiful shader packs.",
    href: "/guides/install-shaders",
    category: "Installation Guides"
  },
  {
    title: "How to Install Resource Packs",
    description: "Customize Minecraft's textures and sounds with resource packs.",
    href: "/guides/install-resourcepacks",
    category: "Installation Guides"
  },
  {
    title: "How to Install Data Packs",
    description: "Add new recipes, loot tables, and mechanics without mods.",
    href: "/guides/install-datapacks",
    category: "Installation Guides"
  },
  {
    title: "How to Install Worlds",
    description: "Play adventure maps and custom world downloads in Minecraft.",
    href: "/guides/install-worlds",
    category: "Installation Guides"
  },
  {
    title: "How to Install Forge",
    description: "Step-by-step guide to installing Minecraft Forge with GDLauncher.",
    href: "/guides/install-forge",
    category: "Mod Loaders"
  },
  {
    title: "How to Install Fabric",
    description: "Learn how to set up Fabric mod loader for Minecraft using GDLauncher.",
    href: "/guides/install-fabric",
    category: "Mod Loaders"
  },
  {
    title: "Allocate More RAM to Minecraft",
    description: "Improve performance by allocating more memory to Minecraft.",
    href: "/guides/allocate-more-ram",
    category: "Performance"
  },
  {
    title: "Performance Mods Guide",
    description: "Boost your FPS with these essential Minecraft performance mods.",
    href: "/guides/performance-mods",
    category: "Performance"
  },
  {
    title: "CurseForge vs Modrinth",
    description: "Compare the two major Minecraft mod platforms and their differences.",
    href: "/guides/curseforge-vs-modrinth",
    category: "Platform Guides"
  }
]

const categories = [...new Set(guides.map(g => g.category))]
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Minecraft Modding Guides | GDLauncher"
      description="Learn how to install modpacks, mods, shaders, and more for Minecraft. Step-by-step tutorials and guides for modded Minecraft."
      keywords="minecraft guides, how to install mods, minecraft modding tutorial, minecraft modpack guide, forge tutorial, fabric tutorial"
    />
  </head>

  <body class="bg-darkSlate-900 text-lightSlate-50 min-h-screen">
    <LoadingBar />
    <!-- Background layers -->
    <div class="fixed inset-0 -z-10">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_0%,rgba(43,107,177,0.12),transparent)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
    </div>
    <Header />

    <main class="py-8">
      <Breadcrumb items={[{ label: "Guides" }]} maxWidth="max-w-6xl" />
      <div class="max-w-6xl mx-auto px-4">
      <div class="bg-darkSlate-800 rounded-xl p-8 md:p-12">
        <!-- Header -->
        <div class="text-center mb-16">
          <h1 class="text-4xl md:text-5xl font-bold text-lightSlate-50 mb-4">
            Minecraft Modding
            <span class="bg-gradient-to-r from-primary-300 to-primary-500 bg-clip-text text-transparent">
              Guides
            </span>
          </h1>
          <p class="text-darkSlate-100 text-lg max-w-2xl mx-auto">
            Learn how to install mods, modpacks, shaders, and more. Step-by-step tutorials to get you started with modded Minecraft.
          </p>
        </div>

        <!-- Guides by category -->
        {categories.map((category) => (
          <section class="mb-12">
            <h2 class="text-2xl font-bold text-lightSlate-50 mb-6">{category}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {guides.filter(g => g.category === category).map((guide) => (
                <a
                  href={guide.href}
                  class="group block p-6 rounded-xl bg-darkSlate-700/50 border border-darkSlate-600 hover:border-primary-500/50 transition-all duration-300 hover:transform hover:-translate-y-1 active:scale-98 ease-spring"
                >
                  <h3 class="text-lg font-semibold text-lightSlate-50 group-hover:text-primary-300 transition-colors mb-2">
                    {guide.title}
                  </h3>
                  <p class="text-sm text-darkSlate-100">
                    {guide.description}
                  </p>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
